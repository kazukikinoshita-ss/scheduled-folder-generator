/**
 * タイムアウト時に起動される再開用関数
 */
function continue_auto_make() {
  auto_make_folder_from_sf(true);
}

/**
 * 登録されている動的トリガーをすべてクリアする
 */
function clearDynamicTriggers() {
  const triggers = ScriptApp.getProjectTriggers();
  for (let i = 0; i < triggers.length; i++) {
    if (triggers[i].getHandlerFunction() === "continue_auto_make") {
      ScriptApp.deleteTrigger(triggers[i]);
    }
  }
}

/**
 * 1分後に再開するための動的トリガーをセットする
 */
function setNextTrigger() {
  ScriptApp.newTrigger("continue_auto_make")
    .timeBased()
    .after(60 * 1000)
    .create();
}

