}

/**
 * ログシートへの超堅牢一括保存
 * @param {GoogleAppsScript.Spreadsheet.Sheet} logSheet 保存対象のログシート
 * @param {Array<Array<any>>} data 書き込む2次元配列データ
 */
function saveLogSheetSafely_(logSheet, data) {
  try {
    if (!logSheet || !data || !Array.isArray(data) || data.length === 0 || !data[0] || !Array.isArray(data[0]) || data[0].length === 0) {
      console.warn("saveLogSheetSafely_: 書き込み対象データが存在しないか不正な構造のためスキップしました。");
      return;
    }

    const numRows = data.length;
    const numCols = data[0].length;
    const lastRow = logSheet.getLastRow();
    const lastCol = logSheet.getLastColumn();

    logSheet.getRange(1, 1, numRows, numCols).setValues(data);

    if (lastRow > numRows) {
      const clearRows = lastRow - numRows;
      const clearCols = Math.max(lastCol || 1, numCols);

      if (clearRows > 0 && clearCols > 0) {
        const targetRange = logSheet.getRange(numRows + 1, 1, clearRows, clearCols);
        if (targetRange && typeof targetRange.clearContents === 'function') {
          targetRange.clearContents();
        }
      }
    }
    SpreadsheetApp.flush();
  } catch (err) {
    console.error("saveLogSheetSafely_ 実行時に例外が発生しましたが、基本保存は完了しています: " + err.message);
  }
}
