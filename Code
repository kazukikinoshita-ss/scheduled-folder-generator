// =========================================================
// 安全な日付変換と文字列平滑化関数
// =========================================================
function parseSafeDate(val) {
  if (val instanceof Date) {
    return isNaN(val.getTime()) ? null : val;
  }
  if (!val) return null;
  
  let str = String(val).trim();
  if (!str) return null;

  if (!isNaN(str)) {
    let num = parseFloat(str);
    if (num > 30000 && num < 60000) { 
      return new Date((num - 25569) * 86400 * 1000);
    }
  }

  str = str.replace(/-/g, "/");
  let d = new Date(str);
  if (!isNaN(d.getTime())) return d;

  if (/^\d{6}$/.test(str)) {
    let y = parseInt(str.substring(0, 4), 10);
    let m = parseInt(str.substring(4, 6), 10) - 1;
    return new Date(y, m, 1);
  }
  
  let matches = str.match(/(\d{4})[\/\-_]?(\d{1,2})([\/\-_]?(\d{1,2}))?/);
  if (matches) {
    let year = parseInt(matches[1], 10);
    let month = parseInt(matches[2], 10) - 1;
    let day = matches[4] ? parseInt(matches[4], 10) : 1;
    return new Date(year, month, day);
  }
  
  return null;
}

function formatCompareValue(val) {
  let d = parseSafeDate(val);
  if (d) {
    return Utilities.formatDate(d, Session.getScriptTimeZone(), "yyyy/MM/dd");
  }
  return String(val).trim();
}

// =========================================================
// マスタからリストを生成する共通ヘルパー
// =========================================================
function buildLayerDataFromMaster(masterData, startNo, layer1Name, monthList, supplierAInput, supplierBInput, isManual) {
  let generated = [];
  let no = startNo;

  const sA = Array.isArray(supplierAInput) ? supplierAInput : (supplierAInput ? [supplierAInput] : []);
  const sB = Array.isArray(supplierBInput) ? supplierBInput : (supplierBInput ? [supplierBInput] : []);

  for (let r = 1; r < masterData.length; r++) { 
    let mRow = masterData[r];
    let rowStr = mRow.join("");
    if (!rowStr) continue; 

    const hasPlaceholderA = mRow.some(cell => /[仕仕][入入][先先][AＡ]/.test(String(cell)));
    const hasPlaceholderB = mRow.some(cell => /[仕仕][入入][先先][BＢ]/.test(String(cell)));
    const hasYYYYMM = mRow.some(cell => /[yY][yY][yY][yY][mM][mM]/.test(String(cell)));

    let targetSuppliers = [""]; 
    let currentType = "";

    if (hasPlaceholderA) {
      if (sA.length === 0) continue; 
      targetSuppliers = sA;
      currentType = "A";
    } else if (hasPlaceholderB) {
      if (sB.length === 0) continue; 
      targetSuppliers = sB;
      currentType = "B";
    }

    for (let sIdx = 0; sIdx < targetSuppliers.length; sIdx++) {
      const currentSupplier = targetSuppliers[sIdx];

      if (hasYYYYMM && monthList.length > 0) {
        for (let m = 0; m < monthList.length; m++) {
          let newRow = [no++];
          for (let c = 0; c < mRow.length; c++) {
            let val = mRow[c];
            if (c === 0) {
              val = layer1Name;
            } else if (/[yY][yY][yY][yY][mM][mM]/.test(String(val))) {
              val = String(val).replace(/[yY][yY][yY][yY][mM][mM]/g, monthList[m]);
            } else if (typeof val === 'string') {
              if (currentType === "A") {
                val = val.replace(/[仕仕][入入][先先][AＡ]/g, currentSupplier);
              } else if (currentType === "B") {
                val = val.replace(/[仕仕][入入][先先][BＢ]/g, currentSupplier);
              }
            }
            if (val !== "") newRow.push(val);
          }
          generated.push(newRow);
        }
      } else {
        let newRow = [no++];
        for (let c = 0; c < mRow.length; c++) {
          let val = mRow[c];
          if (c === 0) {
            val = layer1Name;
          } else if (/[yY][yY][yY][yY][mM][mM]/.test(String(val))) {
            val = "";
          } else if (typeof val === 'string') {
            if (currentType === "A") {
              val = val.replace(/[仕仕][入入][先先][AＡ]/g, currentSupplier);
            } else if (currentType === "B") {
              val = val.replace(/[仕仕][入入][先先][BＢ]/g, currentSupplier);
            }
          }
          if (val !== "") newRow.push(val);
        }
        generated.push(newRow);
      }
    }
  }
  return { data: generated, nextNo: no };
}

// =========================================================
// Slack通知共通関数
// =========================================================
function sendSlackNotification(newFolders) {
  if (newFolders.length === 0) return;

  const webhookUrl = getSlackWebhookUrl();
  if (!webhookUrl) {
    console.error("Slack Webhook URLが設定されていません。");
    return;
  }

  let slackBody = `証憑フォルダが新規作成されました（計 ${newFolders.length} 件）\n` +
                  `-----------------------------------\n`;

  newFolders.forEach((f) => {
    slackBody += `${f.name}\n${f.url}\n\n`;
  });

  slackBody += `-----------------------------------`;

  const options = {
    "method": "POST",
    "contentType": "application/json",
    "payload": JSON.stringify({ "text": slackBody }),
    "muteHttpExceptions": true 
  };

  try {
    UrlFetchApp.fetch(webhookUrl, options);
  } catch (e) {
    console.error("Slack通知通信エラー: " + e.message);
  }
}

// =========================================================
// 【手動モード】個別フォルダ生成＆作成
// =========================================================
function manual_make_folder() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(CONFIG.SHEET_WORKSPACE);
  const masterSheet = ss.getSheetByName(CONFIG.SHEET_MASTER);
  const ui = getSafeUi();

  if (!sheet || !masterSheet) {
    if (ui) ui.alert("必要なシートが見つかりません。");
    return;
  }
  
  const lastRow = sheet.getLastRow();
  if (lastRow >= CONFIG.START_ROW) {
    sheet.getRange(CONFIG.START_ROW, 1, lastRow - (CONFIG.START_ROW - 1), sheet.getLastColumn()).clearContent();
  }

  const folderBaseName = sheet.getRange("B2").getValue();
  const startDate = parseSafeDate(sheet.getRange("B3").getValue());
  const endDate = parseSafeDate(sheet.getRange("B4").getValue());
  const supplierA = sheet.getRange("B5").getValue();
  const supplierB = sheet.getRange("B6").getValue();

  let monthList = [];

  if (startDate && endDate) {
    let currentMonth = new Date(startDate.getTime());
    currentMonth.setDate(1); 
    let endMonth = new Date(endDate.getTime());
    endMonth.setDate(1);

    while (currentMonth <= endMonth) {
      monthList.push(Utilities.formatDate(currentMonth, Session.getScriptTimeZone(), "yyyyMM"));
      currentMonth.setMonth(currentMonth.getMonth() + 1);
    }
  }

  const layer1 = `${folderBaseName}`;

  const masterData = masterSheet.getDataRange().getValues();
  const result = buildLayerDataFromMaster(masterData, 1, layer1, monthList, supplierA, supplierB, true);
  const generatedData = result.data;

  if (generatedData.length === 0) return;

  const maxCol = Math.max(...generatedData.map(row => row.length));
  const formattedData = generatedData.map(row => {
    let newRow = [...row];
    while (newRow.length < maxCol) newRow.push(""); 
    return newRow;
  });

  sheet.getRange(CONFIG.START_ROW, 1, formattedData.length, maxCol).setValues(formattedData);
  SpreadsheetApp.flush(); 

  let folder_id_root = sheet.getRange("B1").getValue().toString().trim();
  const match = folder_id_root.match(/[-\w]{25,}/);
  if (match) folder_id_root = match[0];

  let folder_root;
  try {
    folder_root = DriveApp.getFolderById(folder_id_root);
  } catch (e) {
    if (ui) ui.alert("B1セルのルートフォルダURLが正しくありません。");
    return;
  }

  const folderData = sheet.getRange(CONFIG.START_ROW, 2, formattedData.length, maxCol - 1).getValues();
  let created_count = 0;
  const folderCache = {};
  let layer1Urls = [];
  let newlyCreatedLayer1Folders = [];
  let seenLayer1InThisRun = new Set();

  for (let i = 0; i < folderData.length; i++) {
    let row = folderData[i];
    let folder = folder_root;
    let currentPath = folder_id_root;
    let currentLayer1Url = ""; 
    let isNewLayer1 = false;

    for (let j = 0; j < row.length; j++) {
      if (row[j] === "") continue;

      let folder_name = String(row[j]).trim();
      if (!folder_name) continue;

      currentPath += "/" + folder_name;
      if (folderCache[currentPath]) {
        folder = folderCache[currentPath];
      } else {
        let folders = folder.getFoldersByName(folder_name);
        if (folders.hasNext()) {
          folder = folders.next();
        } else {
          folder = folder.createFolder(folder_name);
          created_count++;
          if (j === 0) isNewLayer1 = true; 
        }
        folderCache[currentPath] = folder;
      }
      
      if (j === 0) {
        currentLayer1Url = folder.getUrl();
        if (isNewLayer1 && !seenLayer1InThisRun.has(folder_name)) {
          newlyCreatedLayer1Folders.push({ name: folder_name, url: currentLayer1Url });
          seenLayer1InThisRun.add(folder_name);
        }
      }
    }
    layer1Urls.push([currentLayer1Url]);
  }

  if (layer1Urls.length > 0) {
    sheet.getRange(CONFIG.START_ROW, maxCol + 1, layer1Urls.length, 1).setValues(layer1Urls);
  }

  sendSlackNotification(newlyCreatedLayer1Folders);

  if (created_count === 0) {
    if (ui) ui.alert("処理完了（すべて作成済みでした）");
  } else {
    if (ui) ui.alert("処理完了：新たに " + created_count + " 個のフォルダを作成しました。\n※Salesforceの該当案件へのURL手動登録をお願いします。");
  }
}

// =========================================================
// 【動的トリガー管理】タイムアウト時の継続実行用
// =========================================================
function continue_auto_make() {
  auto_make_folder_from_sf();
}

function clearDynamicTriggers() {
  const triggers = ScriptApp.getProjectTriggers();
  for (let i = 0; i < triggers.length; i++) {
    if (triggers[i].getHandlerFunction() === "continue_auto_make") {
      ScriptApp.deleteTrigger(triggers[i]);
    }
  }
}

function setNextTrigger() {
  ScriptApp.newTrigger("continue_auto_make")
    .timeBased()
    .after(60 * 1000) // 1分後に再開
    .create();
}

// =========================================================
// 【自動モード】メイン関数
// =========================================================
function auto_make_folder_from_sf() {
  const startTime = Date.now();
  const ui = getSafeUi();
  
  clearDynamicTriggers();

  // 1. 環境初期化・バリデーション
  const env = initializeAutoEnvironment(ui);
  if (!env) return;

  // 2. ログデータ解析（差分検知 ＋ LogからのURL抽出機能）
  const { logSet, logUrlMap } = buildLogDataMaps(env.logData);
  const { groups, hasAnyGroupChanged } = parseSfDataAndDetectChanges(env, logSet, logUrlMap);

  if (!hasAnyGroupChanged) {
    finalizeWithoutChanges(env, ui);
    return;
  }

  // 3. フォルダ生成用階層データの構築（リネーム処理含む）
  const { allGeneratedData, groupsToProcess } = buildFolderHierarchyData(env, groups);

  if (allGeneratedData.length === 0) {
    syncUrlsAndStatuses(env, groups);
    if (groupsToProcess.length === 0) finalizeWithoutChanges(env, ui); 
    else finalizeWithNoMasterMatch(env, ui);
    return;
  }

  writeWorkspaceData(env.mainSheet, allGeneratedData);

  // 4. フォルダの実体作成とURL取得（URL直接指定と名前検索のフォールバック）
  const createResult = executeFolderCreation(env, allGeneratedData, groupsToProcess, startTime);

  // 5. 新規作成分のSlack通知と、SFシートへのURL・ステータス一括同期
  syncUrlsAndStatuses(env, groups, createResult.layer1UrlMapByName);
  sendSlackNotification(createResult.newlyCreatedLayer1Folders);

  // 6. 状態保存と終了処理
  if (createResult.isTimeout) {
    handleTimeoutEnd(env, createResult.completedGroups, createResult.createdCount, ui);
  } else {
    finalizeSuccess(env, createResult.createdCount, ui);
  }
}

