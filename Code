// 【raw_SFリフレッシュ検知】
// =========================================================
/**
 * 「Auto Refresh Execution Log」シートから、raw_SFに対する直近の成功リフレッシュを示す
 * 一意なキー（タイムスタンプ）を取得する。ログシートが存在しない、または該当行がない場合はnullを返す。
 * ログは新しい行が先頭（2行目）に追加される前提で、上から順に最初に一致した行を採用する。
 * @returns {string|null} 直近の成功リフレッシュを示すキー文字列。取得不能な場合はnull
 */
function getLatestRawSfRefreshKey_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const logSheet = ss.getSheetByName(CONFIG.SHEET_REFRESH_LOG);
  if (!logSheet) return null;

  const lastRow = logSheet.getLastRow();
  if (lastRow < 2) return null;

  // A:Refresh Time, B:Sheet, C:Operation, D:Status の4列を読む
  const data = logSheet.getRange(2, 1, lastRow - 1, 4).getValues();

  for (let i = 0; i < data.length; i++) {
    const sheetName = String(data[i][1]).trim();
    const status = String(data[i][3]).trim();
    if (sheetName === CONFIG.SHEET_SF && status === "Success") {
      const ts = data[i][0];
      return (ts instanceof Date) ? String(ts.getTime()) : String(ts).trim();
    }
  }
  return null;
}

// =========================================================
// 【自動モード】メイン関数
// =========================================================
/**
 * SFデータから自動的にフォルダを生成するメイン処理。
 * 注意：時間主導型トリガーはこの関数呼び出し時にトリガーのイベントオブジェクトを
 * 第一引数として自動的に渡してくる（GAS仕様）。そのため、真偽値の厳密比較（=== true）で
 * 判定し、イベントオブジェクトが渡された場合でも誤って「継続実行」と判定しないようにしている。
 * @param {boolean|Object} continuationArg - 継続実行時は明示的に true。トリガー実行時はイベントオブジェクトが入るため、=== true でのみ継続実行とみなす。
 */
function auto_make_folder_from_sf(continuationArg) {
  const isContinuation = (continuationArg === true);

  // 1. 排他制御 (LockServiceによる同時起動・割り込み防止)
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(10000)) { 
    console.warn("他のバッチ処理が実行中のため、競合防止により今回の実行をスキップしました。");
    return;
  }

  const startTime = Date.now();
  const ui = getSafeUi();
  
  clearDynamicTriggers();

  try {
    // 1.5. raw_SFリフレッシュ状況の確認
    //   ・自動実行（トリガー / ui===null）: 前回検知したリフレッシュと変化がなければスキップ
    //   ・手動実行（メニュー / ui!==null）: Salesforceコネクタをマニュアル更新した直後に即実行したい
    //     ケースがあるため、リフレッシュ状況に関わらず常に続行する
    if (!isContinuation) {
      const props = PropertiesService.getScriptProperties();
      const latestKey = getLatestRawSfRefreshKey_();
      const lastSeenKey = props.getProperty(CONFIG.PROP_LAST_REFRESH_KEY);
      const isAutomaticRun = (ui === null);

      if (isAutomaticRun && latestKey !== null && latestKey === lastSeenKey) {
        console.log("【自動実行】raw_SFの最新リフレッシュに変化がないため、今回の実行をスキップしました。（前回検知キー: " + lastSeenKey + "）");
        return;
      }

      if (latestKey !== null) {
        props.setProperty(CONFIG.PROP_LAST_REFRESH_KEY, latestKey);
      } else if (isAutomaticRun) {
        console.warn("Auto Refresh Execution Logからraw_SFのリフレッシュ状況を確認できなかったため、安全側として処理を続行します。");
      }
    }

    // 2. 環境とキャッシュの初期化
    const env = initializeAutoEnvironment(ui, startTime);
    if (!env) return; 

    if (!isContinuation) {
      const lastRow = env.mainSheet.getLastRow();
      const lastCol = env.mainSheet.getLastColumn();
      if (lastRow >= CONFIG.START_ROW && lastCol >= 1) {
        env.mainSheet.getRange(CONFIG.START_ROW, 1, lastRow - CONFIG.START_ROW + 1, lastCol).clearContent();
      }
    }

    // 意図的リセット・手動補正にも対応したズレ修復ロジック
    healRawDataWithLog_(env);

    const totalSfRows = env.sfValues.length - 1; 
    if (totalSfRows <= 0) {
      if (ui) ui.alert("処理対象のデータが存在しません。");
      return;
    }

    const { logSet, logUrlMap } = buildLogDataMaps(env.logData);
    
    // 3. 全行を一括スキャンし、処理が必要な「To-Doリスト」を生成
    const { groups, duplicateErrors } = parseSfDataAndDetectChangesAll(env, logSet, logUrlMap);

    const changedKeys = Object.keys(groups).filter(k => groups[k].isChanged);
    const totalTargets = changedKeys.length;

    // 処理すべき対象がゼロなら即終了
    if (totalTargets === 0) {
      let finalData = env.sfValues;
      if (env.hasUpdates) {
        finalData = persistStatusAndUrlByOppId_(env);
        saveLogSheetSafely_(env.logSheet, finalData);
        SpreadsheetApp.flush();
      }
      sendSlackNotification([], duplicateErrors, [], {});
      finalizeSuccess(env, 0, totalSfRows, ui, duplicateErrors, true);
      return;
    }

    // 4. To-Doリストの消化（マイクロバッチ実行）
    let newlyCreatedLayer1Folders = [];
    let masterSkippedGroups = [];
    let errorGroups = [];
    let allGeneratedDataForWorkspace = [];
    let hierarchyMismatchAlerts = {}; 
    let processedCount = 0;
    let skipCount = 0;
    let errorCount = 0;
    let isTimeout = false;

    for (let i = 0; i < totalTargets; i++) {
      if (Date.now() - env.startTime > CONFIG.TIME_LIMIT_MS) {
        isTimeout = true;
        break;
      }

      const key = changedKeys[i];
      const group = groups[key];
      const layer1 = `PJC：${group.projectCode}（商談名：${group.oppName}）`;
      
      let monthList = buildMonthList(group);
      const result = buildLayerDataFromMaster(env.masterData, 1, layer1, monthList, group.supplierA, group.supplierB, true);
      
      if (result.data.length === 0) {
        masterSkippedGroups.push(group);
        group.rowIndexes.forEach(rowIdx => {
          const r = rowIdx - 1;
          env.sfValues[r][env.indices.status] = "対象外";
          env.hasUpdates = true;
        });
        processedCount++;
        skipCount++;
        continue;
      }

      try {
        const checkRes = checkAndFixUrl(env, group, layer1);
        
        if (!checkRes.isValid) {
          if (checkRes.status === "エラー(階層不一致: 計上部署名相違)") {
            if (!hierarchyMismatchAlerts[group.deptName]) {
              hierarchyMismatchAlerts[group.deptName] = [];
            }
            hierarchyMismatchAlerts[group.deptName].push({
              name: group.oppName,
              url: group.folderUrl || "URLなし"
            });
          } else {
            env.newErrors.push([key]); 
          }
          
          group.rowIndexes.forEach(rowIdx => {
            const r = rowIdx - 1;
            env.sfValues[r][env.indices.status] = checkRes.status;
            env.sfValues[r][env.indices.url] = group.folderUrl; 
            env.hasUpdates = true;
          });
          processedCount++;
          errorCount++;
          continue; 
        }

        const groupGeneratedData = result.data.map(row => {
          let newRow = [...row];
          newRow.splice(1, 0, group.buName, group.deptName); 
          newRow._groupRef = group;
          return newRow;
        });

        const createRes = executeFolderCreationForGroup(env, groupGeneratedData);
        newlyCreatedLayer1Folders.push(...createRes.newFolders);
        allGeneratedDataForWorkspace.push(...groupGeneratedData);

        const latestUrl = createRes.layer1Url || group.folderUrl;
        if (latestUrl) {
          group.rowIndexes.forEach(rowIdx => {
            const r = rowIdx - 1; 
            env.sfValues[r][env.indices.url] = latestUrl;
            env.sfValues[r][env.indices.status] = "完了";
            env.hasUpdates = true;
          });
        }
        processedCount++;
      } catch (e) {
        console.error(`Group ${key} failed: ${e.message}`);
        errorGroups.push(group);
        group.rowIndexes.forEach(rowIdx => {
          const r = rowIdx - 1;
          env.sfValues[r][env.indices.status] = "エラー(作成失敗)";
          env.sfValues[r][env.indices.url] = group.folderUrl; 
          env.hasUpdates = true;
        });
        processedCount++;
        errorCount++;
      }

      Utilities.sleep(CONFIG.API_SLEEP_MS);
    }

    // 5. 処理結果の書き出し
    if (allGeneratedDataForWorkspace.length > 0) {
      writeWorkspaceData(env.mainSheet, allGeneratedDataForWorkspace);
    }
    flushBadUrls(env);

    let finalSfData = env.sfValues;
    if (env.hasUpdates) {
      finalSfData = persistStatusAndUrlByOppId_(env);
      SpreadsheetApp.flush();
    }

    // 6. 終了判定とログ更新・Slack通知 
    sendSlackNotification(newlyCreatedLayer1Folders, duplicateErrors, masterSkippedGroups, hierarchyMismatchAlerts);

    if (isTimeout) {
      saveLogSheetSafely_(env.logSheet, finalSfData);

      const remain = totalTargets - processedCount;
      const msg = `⚠️ 処理時間が上限（3.5分）に達したため中断しました。\n` +
                  `📊 【全体進捗】: 対象タスク ${totalTargets} 件中、${processedCount} 件処理完了。\n` +
                  ` （内訳: フォルダ作成/確認 ${processedCount - skipCount - errorCount}件, 対象外スキップ ${skipCount}件, エラー ${errorCount}件）\n` +
                  `未処理の残りタスク: ${remain} 件\n` +
                  `今回新たに ${newlyCreatedLayer1Folders.length} 個のフォルダを作成しました。\n` +
                  `残りの未処理分は自動的に1分後に再開されます。`;
                  
      if (ui) ui.alert(msg); 
      else console.log(msg);
      
      setNextTrigger();
    } else {
      finalizeSuccess(env, newlyCreatedLayer1Folders.length, totalSfRows, ui, duplicateErrors, false);
    }

  } finally {
    lock.releaseLock();
  }
}

