/**
 * SlackへPOSTリクエストを送信する内部関数 (Payload受信型へ変更)
 * @param {Object} payload 送信するJSONペイロードオブジェクト
 */
function sendSlackMessage_(payload) {
  const webhookUrl = getSlackWebhookUrl();
  if (!webhookUrl || !payload) return;
  const options = {
    "method": "POST",
    "contentType": "application/json",
    "payload": JSON.stringify(payload),
    "muteHttpExceptions": true 
  };
  try {
    UrlFetchApp.fetch(webhookUrl, options);
  } catch (e) {
    console.error("Slack通知通信エラー: " + e.message);
  }
}

/**
 * 処理結果を判定し、必要に応じてSlackへの通知（分割含む）を制御する
 */
function sendSlackNotification(newFolders, duplicateErrors = [], skippedGroups = [], hierarchyMismatchAlerts = {}) {
  const mismatchDepts = Object.keys(hierarchyMismatchAlerts);
  
  if (newFolders.length === 0 && duplicateErrors.length === 0 && skippedGroups.length === 0 && mismatchDepts.length === 0) {
    console.log("通知対象がないため、Slack通知をスキップしました。");
    return;
  }

  // API制限回避用ヘルパー関数：通知の間に必ず1秒ウェイトを挟む
  let hasSentSomething = false;
  const safeSend = (payload) => {
    if (hasSentSomething) Utilities.sleep(1000);
    sendSlackMessage_(payload);
    hasSentSomething = true;
  };

  // 1. 階層エラー通知（赤色のアタッチメント）
  if (mismatchDepts.length > 0) {
    let mismatchText = `以下の理由により、指定されたURLのフォルダ階層が不正と判定されました。\n` +
                       `[原因1] 担当者が誤った場所（マイドライブや別部署など）のフォルダURLを指定している\n` +
                       `[原因2] 組織変更等により、SF上の「計上部署名」とドライブ上の親フォルダ名にズレが生じている\n\n`;
    
    mismatchDepts.forEach(dept => {
      const errors = hierarchyMismatchAlerts[dept];
      const total = errors.length;
      mismatchText += `*・SF上の計上部署名:* \`${dept}\` （該当案件数: ${total}件）\n`;
      
      const displayLimit = CONFIG.SLACK_MAX_ERRORS_PER_DEPT || 10;
      const displayCount = Math.min(total, displayLimit);
      
      for(let i = 0; i < displayCount; i++) {
        mismatchText += `  - 商談: ${errors[i].name}\n    URL: ${errors[i].url}\n`;
      }
      if (total > displayLimit) {
        mismatchText += `  ※他 ${total - displayLimit}件のエラーがあります。スプレッドシートを確認してください。\n`;
      }
      mismatchText += `\n`;
    });

    safeSend({
      attachments: [{
        color: CONFIG.SLACK_COLORS.ERROR,
        title: "🚨 【警告】親フォルダ階層の不整合エラー",
        text: mismatchText
      }]
    });
  }
  
  // 2. スキップ案件通知（黄色のアタッチメント）
  if (skippedGroups.length > 0) {
    let skipText = `以下の案件はマスタの条件（仕入先など）を満たさなかったため、「対象外」として処理されました。\n\n`;
    skippedGroups.forEach(g => {
      skipText += `・商談名: ${g.oppName} (PJC: ${g.projectCode})\n`;
    });

    safeSend({
      attachments: [{
        color: CONFIG.SLACK_COLORS.WARNING,
        title: "⚠️ 【通知】マスタ生成条件不一致（対象外としてスキップ）",
        text: skipText
      }]
    });
  }

  // 3. 新規作成フォルダ通知（緑色のアタッチメント・分割処理対応）
  if (newFolders.length > 0) {
    const successLimit = 20; 
    for (let i = 0; i < newFolders.length; i += successLimit) {
      const chunk = newFolders.slice(i, i + successLimit);
      let titleStr = `📁 証憑フォルダが新規作成されました（計 ${newFolders.length} 件）`;
      if (newFolders.length > successLimit) {
        titleStr = `[分割通知 ${Math.floor(i / successLimit) + 1}/${Math.ceil(newFolders.length / successLimit)}] ` + titleStr;
      }

      let successText = "";
      chunk.forEach((f) => {
        successText += `*${f.name}*\n${f.url}\n\n`;
      });
      
      safeSend({
        attachments: [{
          color: CONFIG.SLACK_COLORS.SUCCESS,
          title: titleStr,
          text: successText
        }]
      });
    }
  }

  // 4. 重複エラー通知（赤色のアタッチメント・分割処理対応・表示名改善対応）
  if (duplicateErrors.length > 0) {
    let flatDupMessages = [];
    duplicateErrors.forEach(err => {
      err.oppDetails.forEach(oppInfo => {
        flatDupMessages.push(`・対象商談: ${oppInfo}\n  URL: ${err.url}`);
      });
    });

    const dupLimit = 10;
    for (let i = 0; i < flatDupMessages.length; i += dupLimit) {
      const chunk = flatDupMessages.slice(i, i + dupLimit);
      let titleStr = `🚨 【警告】URL重複エラー（新規検知 / 処理スキップ）`;
      if (flatDupMessages.length > dupLimit) {
        titleStr = `[分割通知 ${Math.floor(i / dupLimit) + 1}/${Math.ceil(flatDupMessages.length / dupLimit)}] ` + titleStr;
      }

      let dupText = `異なる商談間で同一のURLが指定されています。Salesforceのデータを確認してください。\n\n` + chunk.join("\n\n");
      
      safeSend({
        attachments: [{
          color: CONFIG.SLACK_COLORS.ERROR,
          title: titleStr,
          text: dupText
        }]
      });
    }
  }
}

// =========================================================
// 【手動モード】個別フォルダ生成＆作成
// =========================================================
function manual_make_folder() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(CONFIG.SHEET_WORKSPACE);
  const masterSheet = ss.getSheetByName(CONFIG.SHEET_MASTER);
  const ui = getSafeUi();

  if (!sheet || !masterSheet) {
    if (ui) ui.alert("必要なシートが見つかりません。");
    return;
  }
  
  const lastRow = sheet.getLastRow();
  if (lastRow >= CONFIG.START_ROW) {
    sheet.getRange(CONFIG.START_ROW, 1, lastRow - (CONFIG.START_ROW - 1), sheet.getLastColumn()).clearContent();
  }

  const folderBaseName = sheet.getRange("B2").getValue();
  const startDate = parseSafeDate(sheet.getRange("B3").getValue());
  const endDate = parseSafeDate(sheet.getRange("B4").getValue());
  const supplierA = sheet.getRange("B5").getValue();
  const supplierB = sheet.getRange("B6").getValue();

  let monthList = [];

  if (startDate && endDate) {
    let currentMonth = new Date(startDate.getTime());
    currentMonth.setDate(1); 
    let endMonth = new Date(endDate.getTime());
    endMonth.setDate(1);

    while (currentMonth <= endMonth) {
      monthList.push(Utilities.formatDate(currentMonth, Session.getScriptTimeZone(), "yyyyMM"));
      currentMonth.setMonth(currentMonth.getMonth() + 1);
    }
  }

  const layer1 = `${folderBaseName}`;

  const masterData = masterSheet.getDataRange().getValues();
  const result = buildLayerDataFromMaster(masterData, 1, layer1, monthList, supplierA, supplierB, true);
  const generatedData = result.data;

  if (generatedData.length === 0) return;

  const maxCol = Math.max(...generatedData.map(row => row.length));
  const formattedData = generatedData.map(row => {
    let newRow = [...row];
    while (newRow.length < maxCol) newRow.push(""); 
    return newRow;
  });

  sheet.getRange(CONFIG.START_ROW, 1, formattedData.length, maxCol).setValues(formattedData);
  SpreadsheetApp.flush(); 

  let raw_folder_id = sheet.getRange("B1").getValue().toString().trim();
  let folder_id_root = extractCleanDriveId_(raw_folder_id) || raw_folder_id;

  let folder_root;
  try {
    folder_root = DriveApp.getFolderById(folder_id_root);
    if (folder_root.isTrashed()) {
      if (ui) ui.alert("B1セルのルートフォルダがゴミ箱に入っています。");
      return;
    }
  } catch (e) {
    if (ui) ui.alert("B1セルのルートフォルダURLが正しくありません。");
    return;
  }

  const folderData = sheet.getRange(CONFIG.START_ROW, 2, formattedData.length, maxCol - 1).getValues();
  let created_count = 0;
  const folderCache = {};
  let layer1Urls = [];
  let newlyCreatedLayer1Folders = [];
  let seenLayer1InThisRun = new Set();

  for (let i = 0; i < folderData.length; i++) {
    let row = folderData[i];
    let folder = folder_root;
    let currentPath = folder_id_root;
    let currentLayer1Url = ""; 
    let isNewLayer1 = false;

    for (let j = 0; j < row.length; j++) {
      if (row[j] === "") continue;

      let folder_name = String(row[j]).trim();
      if (!folder_name) continue;

      currentPath += "/" + folder_name;
      if (folderCache[currentPath]) {
        folder = folderCache[currentPath];
      } else {
        let folders = folder.getFoldersByName(folder_name);
        let foundFolder = null;
        while (folders.hasNext()) {
          let f = folders.next();
          if (!f.isTrashed()) {
            foundFolder = f;
            break;
          }
        }

        if (foundFolder) {
          folder = foundFolder;
        } else {
          folder = folder.createFolder(folder_name);
          created_count++;
          if (j === 0) isNewLayer1 = true; 
        }
        folderCache[currentPath] = folder;
      }
      
      if (j === 0) {
        currentLayer1Url = folder.getUrl();
        if (isNewLayer1 && !seenLayer1InThisRun.has(folder_name)) {
          newlyCreatedLayer1Folders.push({ name: folder_name, url: currentLayer1Url });
          seenLayer1InThisRun.add(folder_name);
        }
      }
    }
    layer1Urls.push([currentLayer1Url]);
  }

  if (layer1Urls.length > 0) {
    sheet.getRange(CONFIG.START_ROW, maxCol + 1, layer1Urls.length, 1).setValues(layer1Urls);
  }

  sendSlackNotification(newlyCreatedLayer1Folders);

  if (created_count === 0) {
    if (ui) ui.alert("処理完了（すべて作成済みでした）");
  } else {
    if (ui) ui.alert("処理完了：新たに " + created_count + " 個のフォルダを作成しました。\n※Salesforceの該当案件へのURL手動登録をお願いします。");
  }
}

