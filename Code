// =========================================================
// URL・Google Drive IDの超堅牢抽出パーサー
// =========================================================
/**
 * HTMLタグやURLエンコードされた文字列から純粋なGoogle Drive IDを正確に抽出する
 * @param {any} rawInput - Salesforceから渡されたHTML文字列またはURL
 * @returns {string|null} 抽出された純粋なGoogle Drive ID（抽出不能な場合はnull）
 */
function extractCleanDriveId_(rawInput) {
  if (!rawInput) return null;
  let str = String(rawInput).trim();
  if (!str) return null;

  try {
    str = decodeURIComponent(str);
  } catch (e) {
    // デコード例外が発生した場合は元の文字列で続行
  }

  let mFolder = str.match(/folders\/([a-zA-Z0-9_-]{25,})/);
  if (mFolder) return mFolder[1];

  let mId = str.match(/[?&]id=([a-zA-Z0-9_-]{25,})/);
  if (mId) return mId[1];

  let mD = str.match(/\/d\/([a-zA-Z0-9_-]{25,})/);
  if (mD) return mD[1];

  let mGen = str.match(/([a-zA-Z0-9_-]{25,})/);
  if (mGen) {
    let matched = mGen[1];
    if ((matched.startsWith("2F") || matched.startsWith("3D")) && matched.length > 30) {
      matched = matched.substring(2);
    }
    return matched;
  }

  return null;
}

// =========================================================
// 安全な日付変換と文字列平滑化関数
// =========================================================
/**
 * 様々な形式の日付文字列や数値をパースし、安全にDateオブジェクトに変換する
 * @param {any} val - 変換対象の値
 * @returns {Date|null}
 */
function parseSafeDate(val) {
  if (val instanceof Date) {
    return isNaN(val.getTime()) ? null : val;
  }
  if (!val) return null;
  
  let str = String(val).trim();
  if (!str) return null;

  if (!isNaN(str)) {
    let num = parseFloat(str);
    if (num > 30000 && num < 60000) { 
      return new Date((num - 25569) * 86400 * 1000);
    }
  }

  str = str.replace(/-/g, "/");
  let d = new Date(str);
  if (!isNaN(d.getTime())) return d;

  if (/^\d{6}$/.test(str)) {
    let y = parseInt(str.substring(0, 4), 10);
    let m = parseInt(str.substring(4, 6), 10) - 1;
    return new Date(y, m, 1);
  }
  
  let matches = str.match(/(\d{4})[\/\-_]?(\d{1,2})([\/\-_]?(\d{1,2}))?/);
  if (matches) {
    let year = parseInt(matches[1], 10);
    let month = parseInt(matches[2], 10) - 1;
    let day = matches[4] ? parseInt(matches[4], 10) : 1;
    return new Date(year, month, day);
  }
  return null;
}

/**
 * 差分比較用に値を平滑化（フォーマット）する
 * @param {any} val - フォーマット対象の値
 * @returns {string}
 */
function formatCompareValue(val) {
  let d = parseSafeDate(val);
  if (d) {
    return Utilities.formatDate(d, Session.getScriptTimeZone(), "yyyy/MM/dd");
  }
  return String(val).trim();
}

// =========================================================
// マスタからリストを生成する共通ヘルパー
// =========================================================
/**
 * マスタシートの定義に基づいて、フォルダ作成用の中間データを生成する
 */
function buildLayerDataFromMaster(masterData, startNo, layer1Name, monthList, supplierAInput, supplierBInput, isManual) {
  let generated = [];
  let no = startNo;

  const sA = Array.isArray(supplierAInput) ? supplierAInput : (supplierAInput ? [supplierAInput] : []);
  const sB = Array.isArray(supplierBInput) ? supplierBInput : (supplierBInput ? [supplierBInput] : []);

  for (let r = 1; r < masterData.length; r++) { 
    let mRow = masterData[r];
    let rowStr = mRow.join("");
    if (!rowStr) continue; 

    const hasPlaceholderA = mRow.some(cell => /[仕仕][入入][先先][AＡ]/.test(String(cell)));
    const hasPlaceholderB = mRow.some(cell => /[仕仕][入入][先先][BＢ]/.test(String(cell)));
    const hasYYYYMM = mRow.some(cell => /[yY][yY][yY][yY][mM][mM]/.test(String(cell)));

    let targetSuppliers = [""]; 
    let currentType = "";

    if (hasPlaceholderA) {
      if (sA.length === 0) continue; 
      targetSuppliers = sA;
      currentType = "A";
    } else if (hasPlaceholderB) {
      if (sB.length === 0) continue; 
      targetSuppliers = sB;
      currentType = "B";
    }

    for (let sIdx = 0; sIdx < targetSuppliers.length; sIdx++) {
      const currentSupplier = targetSuppliers[sIdx];

      if (hasYYYYMM && monthList.length > 0) {
        for (let m = 0; m < monthList.length; m++) {
          let newRow = [no++];
          for (let c = 0; c < mRow.length; c++) {
            let val = mRow[c];
            if (c === 0) {
              val = layer1Name;
            } else if (/[yY][yY][yY][yY][mM][mM]/.test(String(val))) {
              val = String(val).replace(/[yY][yY][yY][yY][mM][mM]/g, monthList[m]);
            } else if (typeof val === 'string') {
              if (currentType === "A") val = val.replace(/[仕仕][入入][先先][AＡ]/g, currentSupplier);
              else if (currentType === "B") val = val.replace(/[仕仕][入入][先先][BＢ]/g, currentSupplier);
            }
            if (val !== "") newRow.push(val);
          }
          generated.push(newRow);
        }
      } else {
        let newRow = [no++];
        for (let c = 0; c < mRow.length; c++) {
          let val = mRow[c];
          if (c === 0) {
            val = layer1Name;
          } else if (/[yY][yY][yY][yY][mM][mM]/.test(String(val))) {
            val = "";
          } else if (typeof val === 'string') {
            if (currentType === "A") val = val.replace(/[仕仕][入入][先先][AＡ]/g, currentSupplier);
            else if (currentType === "B") val = val.replace(/[仕仕][入入][先先][BＢ]/g, currentSupplier);
          }
          if (val !== "") newRow.push(val);
        }
        generated.push(newRow);
      }
    }
  }
  return { data: generated, nextNo: no };
}

// =========================================================
// Slack通知共通関数
// =========================================================
/**
 * Slackに作成結果または警告を通知する
 */
function sendSlackNotification(newFolders, duplicateErrors = [], skippedGroups = []) {
  if (newFolders.length === 0 && duplicateErrors.length === 0 && skippedGroups.length === 0) {
    console.log("通知対象がないため、Slack通知をスキップしました。");
    return;
  }

  const webhookUrl = getSlackWebhookUrl();
  if (!webhookUrl) {
    console.error("Slack Webhook URLが設定されていません。");
    return;
  }

  let slackBody = "";
  
  if (newFolders.length > 0) {
    slackBody += `📁 証憑フォルダが新規作成されました（計 ${newFolders.length} 件）\n` +
                 `-----------------------------------\n`;
    newFolders.forEach((f) => {
      slackBody += `${f.name}\n${f.url}\n\n`;
    });
    slackBody += `-----------------------------------\n`;
  }

  if (duplicateErrors.length > 0) {
    slackBody += `\n🚨 【警告】URL重複エラー（処理スキップ）\n` +
                 `異なる商談間で同一のURLが指定されているため、以下の案件は処理をスキップしました。\nSalesforceのデータを確認してください。\n` +
                 `-----------------------------------\n`;
    duplicateErrors.forEach(err => {
      slackBody += `・URL: ${err.url}\n  対象商談ID: ${err.oppIds.join(", ")}\n\n`;
    });
    slackBody += `-----------------------------------\n`;
  }

  if (skippedGroups.length > 0) {
    slackBody += `\n⚠️ 【通知】マスタ生成条件不一致（対象外としてスキップ）\n` +
                 `以下の案件はマスタの条件（仕入先など）を満たさなかったため、「対象外」として処理されました。\n` +
                 `-----------------------------------\n`;
    skippedGroups.forEach(g => {
      slackBody += `・商談名: ${g.oppName} (PJC: ${g.projectCode})\n`;
    });
    slackBody += `-----------------------------------`;
  }

  const options = {
    "method": "POST",
    "contentType": "application/json",
    "payload": JSON.stringify({ "text": slackBody }),
    "muteHttpExceptions": true 
  };

  try {
    UrlFetchApp.fetch(webhookUrl, options);
  } catch (e) {
    console.error("Slack通知通信エラー: " + e.message);
  }
}

// =========================================================
// 【手動モード】個別フォルダ生成＆作成
// =========================================================
function manual_make_folder() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(CONFIG.SHEET_WORKSPACE);
  const masterSheet = ss.getSheetByName(CONFIG.SHEET_MASTER);
  const ui = getSafeUi();

  if (!sheet || !masterSheet) {
    if (ui) ui.alert("必要なシートが見つかりません。");
    return;
  }
  
  const lastRow = sheet.getLastRow();
  if (lastRow >= CONFIG.START_ROW) {
    sheet.getRange(CONFIG.START_ROW, 1, lastRow - (CONFIG.START_ROW - 1), sheet.getLastColumn()).clearContent();
  }

  const folderBaseName = sheet.getRange("B2").getValue();
  const startDate = parseSafeDate(sheet.getRange("B3").getValue());
  const endDate = parseSafeDate(sheet.getRange("B4").getValue());
  const supplierA = sheet.getRange("B5").getValue();
  const supplierB = sheet.getRange("B6").getValue();

  let monthList = [];

  if (startDate && endDate) {
    let currentMonth = new Date(startDate.getTime());
    currentMonth.setDate(1); 
    let endMonth = new Date(endDate.getTime());
    endMonth.setDate(1);

    while (currentMonth <= endMonth) {
      monthList.push(Utilities.formatDate(currentMonth, Session.getScriptTimeZone(), "yyyyMM"));
      currentMonth.setMonth(currentMonth.getMonth() + 1);
    }
  }

  const layer1 = `${folderBaseName}`;

  const masterData = masterSheet.getDataRange().getValues();
  const result = buildLayerDataFromMaster(masterData, 1, layer1, monthList, supplierA, supplierB, true);
  const generatedData = result.data;

  if (generatedData.length === 0) return;

  const maxCol = Math.max(...generatedData.map(row => row.length));
  const formattedData = generatedData.map(row => {
    let newRow = [...row];
    while (newRow.length < maxCol) newRow.push(""); 
    return newRow;
  });

  sheet.getRange(CONFIG.START_ROW, 1, formattedData.length, maxCol).setValues(formattedData);
  SpreadsheetApp.flush(); 

  let raw_folder_id = sheet.getRange("B1").getValue().toString().trim();
  let folder_id_root = extractCleanDriveId_(raw_folder_id) || raw_folder_id;

  let folder_root;
  try {
    folder_root = DriveApp.getFolderById(folder_id_root);
    if (folder_root.isTrashed()) {
      if (ui) ui.alert("B1セルのルートフォルダがゴミ箱に入っています。");
      return;
    }
  } catch (e) {
    if (ui) ui.alert("B1セルのルートフォルダURLが正しくありません。");
    return;
  }

  const folderData = sheet.getRange(CONFIG.START_ROW, 2, formattedData.length, maxCol - 1).getValues();
  let created_count = 0;
  const folderCache = {};
  let layer1Urls = [];
  let newlyCreatedLayer1Folders = [];
  let seenLayer1InThisRun = new Set();

  for (let i = 0; i < folderData.length; i++) {
    let row = folderData[i];
    let folder = folder_root;
    let currentPath = folder_id_root;
    let currentLayer1Url = ""; 
    let isNewLayer1 = false;

    for (let j = 0; j < row.length; j++) {
      if (row[j] === "") continue;

      let folder_name = String(row[j]).trim();
      if (!folder_name) continue;

      currentPath += "/" + folder_name;
      if (folderCache[currentPath]) {
        folder = folderCache[currentPath];
      } else {
        let folders = folder.getFoldersByName(folder_name);
        let foundFolder = null;
        while (folders.hasNext()) {
          let f = folders.next();
          if (!f.isTrashed()) {
            foundFolder = f;
            break;
          }
        }

        if (foundFolder) {
          folder = foundFolder;
        } else {
          folder = folder.createFolder(folder_name);
          created_count++;
          if (j === 0) isNewLayer1 = true; 
        }
        folderCache[currentPath] = folder;
      }
      
      if (j === 0) {
        currentLayer1Url = folder.getUrl();
        if (isNewLayer1 && !seenLayer1InThisRun.has(folder_name)) {
          newlyCreatedLayer1Folders.push({ name: folder_name, url: currentLayer1Url });
          seenLayer1InThisRun.add(folder_name);
        }
      }
    }
    layer1Urls.push([currentLayer1Url]);
  }

  if (layer1Urls.length > 0) {
    sheet.getRange(CONFIG.START_ROW, maxCol + 1, layer1Urls.length, 1).setValues(layer1Urls);
  }

  sendSlackNotification(newlyCreatedLayer1Folders);

  if (created_count === 0) {
    if (ui) ui.alert("処理完了（すべて作成済みでした）");
  } else {
    if (ui) ui.alert("処理完了：新たに " + created_count + " 個のフォルダを作成しました。\n※Salesforceの該当案件へのURL手動登録をお願いします。");
  }
}

// =========================================================
// 【動的トリガー管理】
// =========================================================
/**
 * タイムアウト時に起動される再開用関数
 */
function continue_auto_make() {
  auto_make_folder_from_sf();
}

/**
 * 登録されている動的トリガーをすべてクリアする
 */
function clearDynamicTriggers() {
  const triggers = ScriptApp.getProjectTriggers();
  for (let i = 0; i < triggers.length; i++) {
    if (triggers[i].getHandlerFunction() === "continue_auto_make") {
      ScriptApp.deleteTrigger(triggers[i]);
    }
  }
}

/**
 * 1分後に再開するための動的トリガーをセットする
 */
function setNextTrigger() {
  ScriptApp.newTrigger("continue_auto_make")
    .timeBased()
    .after(60 * 1000)
    .create();
}

// =========================================================
// 【自動モード】メイン関数 (★v1.10.8 メタデータ差分検知・自動リネーム対応版)
// =========================================================
/**
 * SFデータから自動的にフォルダを生成するメイン処理
 */
function auto_make_folder_from_sf() {
  // 1. 排他制御 (LockServiceによる同時起動・割り込み防止)
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(10000)) { // 10秒待機して取得できなければスキップ
    console.warn("他のバッチ処理が実行中のため、競合防止により今回の実行をスキップしました。");
    return;
  }

  const startTime = Date.now();
  const ui = getSafeUi();
  
  clearDynamicTriggers();

  try {
    // 2. 環境とキャッシュの初期化
    const env = initializeAutoEnvironment(ui, startTime);
    if (!env) return;

    // 【v1.10.8 改修】Salesforce ConnectorによるL/M列のズレ修復 ＋ ProjectCode/商談名変更の検知
    healRawDataWithLog_(env);

    const totalSfRows = env.sfValues.length - 1; 
    if (totalSfRows <= 0) {
      if (ui) ui.alert("処理対象のデータが存在しません。");
      return;
    }

    const { logSet, logUrlMap } = buildLogDataMaps(env.logData);
    
    // 3. 全行を一括スキャンし、処理が必要な「To-Doリスト」を生成
    // ※ sfData(生データ)ではなく、healRawDataWithLog_で修復済みの sfValues を使用します
    const { groups, duplicateErrors } = parseSfDataAndDetectChangesAll(env, logSet, logUrlMap);

    const changedKeys = Object.keys(groups).filter(k => groups[k].isChanged);
    const totalTargets = changedKeys.length;

    // 処理すべき対象がゼロなら即終了 (ただし修復による更新があれば保存)
    if (totalTargets === 0) {
      if (env.hasUpdates) {
        env.sfSheet.getRange(1, 1, env.sfValues.length, env.sfValues[0].length).setValues(env.sfValues);
        saveLogSheetSafely_(env.logSheet, env.sfValues);
        SpreadsheetApp.flush();
      }
      finalizeSuccess(env, 0, totalSfRows, ui, duplicateErrors, true);
      return;
    }

    // 4. To-Doリストの消化（マイクロバッチ実行）
    let newlyCreatedLayer1Folders = [];
    let masterSkippedGroups = [];
    let errorGroups = [];
    let allGeneratedDataForWorkspace = [];
    let processedCount = 0;
    let skipCount = 0;
    let errorCount = 0;
    let isTimeout = false;

    for (let i = 0; i < totalTargets; i++) {
      // タイムアウトチェック (3.5分限界安全値)
      if (Date.now() - env.startTime > CONFIG.TIME_LIMIT_MS) {
        isTimeout = true;
        break;
      }

      const key = changedKeys[i];
      const group = groups[key];
      const layer1 = `PJC：${group.projectCode}（商談名：${group.oppName}）`;
      
      // マスタ条件チェックを先に行い、対象外なら即スキップしてステータス更新
      let monthList = buildMonthList(group);
      const result = buildLayerDataFromMaster(env.masterData, 1, layer1, monthList, group.supplierA, group.supplierB, true);
      
      if (result.data.length === 0) {
        masterSkippedGroups.push(group);
        group.rowIndexes.forEach(rowIdx => {
          const r = rowIdx - 1;
          env.sfValues[r][env.indices.status] = "対象外";
          env.hasUpdates = true;
        });
        processedCount++;
        skipCount++;
        continue;
      }

      // 堅牢な例外処理と Drive 通信実行
      try {
        let folderUrlObj = { url: group.folderUrl };
        
        if (!checkAndFixUrl(env, folderUrlObj, layer1)) {
          env.newErrors.push([key]); 
          group.rowIndexes.forEach(rowIdx => {
            const r = rowIdx - 1;
            env.sfValues[r][env.indices.status] = "エラー(無効URL)";
            env.hasUpdates = true;
          });
          processedCount++;
          errorCount++;
          continue; 
        }
        
        group.folderUrl = folderUrlObj.url;

        const groupGeneratedData = result.data.map(row => {
          let newRow = [...row];
          newRow.splice(1, 0, group.buName, group.deptName); 
          newRow._groupRef = group;
          return newRow;
        });

        // ドライブ検索・フォルダ作成の実行
        const createRes = executeFolderCreationForGroup(env, groupGeneratedData);
        newlyCreatedLayer1Folders.push(...createRes.newFolders);
        allGeneratedDataForWorkspace.push(...groupGeneratedData);

        const latestUrl = createRes.layer1Url || group.folderUrl;
        if (latestUrl) {
          group.rowIndexes.forEach(rowIdx => {
            const r = rowIdx - 1; 
            env.sfValues[r][env.indices.url] = latestUrl;
            env.sfValues[r][env.indices.status] = "完了";
            env.hasUpdates = true;
          });
        }
        processedCount++;
      } catch (e) {
        console.error(`Group ${key} failed: ${e.message}`);
        errorGroups.push(group);
        group.rowIndexes.forEach(rowIdx => {
          const r = rowIdx - 1;
          env.sfValues[r][env.indices.status] = "エラー(作成失敗)";
          env.hasUpdates = true;
        });
        processedCount++;
        errorCount++;
      }

      // APIレート制限回避のためのスロットリング (0.1秒)
      Utilities.sleep(CONFIG.API_SLEEP_MS);
    }

    // 5. 処理結果の書き出し (Workspace, エラーキャッシュ)
    if (allGeneratedDataForWorkspace.length > 0) {
      writeWorkspaceData(env.mainSheet, allGeneratedDataForWorkspace);
    }
    flushBadUrls(env);

    // raw_SF の一括更新 (修復されたズレデータを含む)
    if (env.hasUpdates) {
      env.sfSheet.getRange(1, 1, env.sfValues.length, env.sfValues[0].length).setValues(env.sfValues);
      SpreadsheetApp.flush();
    }

    // 6. 終了判定とログ更新
    if (isTimeout) {
      // タイムアウト時も安全に log_SF を上書き同期
      saveLogSheetSafely_(env.logSheet, env.sfValues);

      const remain = totalTargets - processedCount;
      const msg = `⚠️ 処理時間が上限（3.5分）に達したため中断しました。\n` +
                  `📊 【全体進捗】: 対象タスク ${totalTargets} 件中、${processedCount} 件処理完了。\n` +
                  ` （内訳: フォルダ作成/確認 ${processedCount - skipCount - errorCount}件, 対象外スキップ ${skipCount}件, エラー ${errorCount}件）\n` +
                  `未処理の残りタスク: ${remain} 件\n` +
                  `今回新たに ${newlyCreatedLayer1Folders.length} 個のフォルダを作成しました。\n` +
                  `残りの未処理分は自動的に1分後に再開されます。`;
                  
      if (ui) ui.alert(msg); 
      else console.log(msg);
      
      setNextTrigger();
    } else {
      // 完走時
      sendSlackNotification(newlyCreatedLayer1Folders, duplicateErrors, masterSkippedGroups);
      finalizeSuccess(env, newlyCreatedLayer1Folders.length, totalSfRows, ui, duplicateErrors, false);
    }

  } finally {
    // ロックの確実な解放
    lock.releaseLock();
  }
}

