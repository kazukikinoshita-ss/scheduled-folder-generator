/**
 * 【v1.10.8 追加ロジック】
 * Salesforce Connectorによる行のズレを解消するとともに、
 * 過去の履歴(log_SF)と現在のメタデータ(ProjectCode/商談名)を比較し、
 * 変更があれば強制的に更新対象（リネーム処理対象）とする。
 */
function healRawDataWithLog_(env) {
  const { sfValues, logData, indices } = env;
  if (!logData || logData.length <= 1) return; 

  const logHeaders = logData[0];
  const logIdx = {
    oppId: logHeaders.findIndex(h => String(h).replace(/\s/g, "").includes("商談ID") || String(h).replace(/\s/g, "").toLowerCase().includes("opportunityid")),
    pCode: logHeaders.findIndex(h => String(h).replace(/\s/g, "").toLowerCase().includes("projectcode") || String(h).replace(/\s/g, "").includes("プロジェクトコード")),
    name: logHeaders.findIndex(h => String(h).replace(/\s/g, "").includes("商谈名") || String(h).replace(/\s/g, "").includes("商談名")),
    status: logHeaders.indexOf("自動作成ステータス"),
    url: logHeaders.indexOf("格納先フォルダURL")
  };

  if (logIdx.oppId === -1) return; // ログ側に商談IDが見つからない場合は修復不能としてリターン

  // logDataから商談IDをキーとした履歴(絶対的な真実)マップを作成
  const logMap = {};
  for (let r = 1; r < logData.length; r++) {
    const oppId = String(logData[r][logIdx.oppId]).trim();
    if (oppId) {
      logMap[oppId] = {
        status: logIdx.status !== -1 ? (logData[r][logIdx.status] || "") : "",
        url: logIdx.url !== -1 ? (logData[r][logIdx.url] || "") : "",
        pCode: logIdx.pCode !== -1 ? String(logData[r][logIdx.pCode]).trim() : "",
        name: logIdx.name !== -1 ? String(logData[r][logIdx.name]).trim() : ""
      };
    }
  }

  // sfValues (raw_SFのコピー) をスキャンして修復および差分検知を実行
  for (let i = 1; i < sfValues.length; i++) {
    const oppId = String(sfValues[i][indices.oppId]).trim();
    if (!oppId) continue;

    if (logMap[oppId]) {
      // 現在の生データ（raw_SF）のProjectCodeと商談名
      const rawPCode = indices.pCode !== -1 ? String(sfValues[i][indices.pCode]).trim() : "";
      const rawName = indices.name !== -1 ? String(sfValues[i][indices.name]).trim() : "";
      // ログデータ（log_SF）に記録されている前回のProjectCodeと商談名
      const logPCode = logMap[oppId].pCode;
      const logName = logMap[oppId].name;

      // メタデータに変更があるか（事後発番や名称変更）をチェック
      if (rawPCode !== logPCode || rawName !== logName) {
        // 💡 変更検知 (Change Data Capture)
        // URLは維持しつつ、ステータスを意図的に空欄にすることで強制的に更新(リネーム)処理へ回す
        sfValues[i][indices.status] = ""; 
        sfValues[i][indices.url] = logMap[oppId].url;
      } else {
        // 💡 変更なし・完全一致
        // ステータスとURLを元通りに修復し、不要なAPI通信をスキップさせる
        sfValues[i][indices.status] = logMap[oppId].status;
        sfValues[i][indices.url] = logMap[oppId].url;
      }
    } else {
      // 履歴にない(真に新規の案件)場合は、ズレによって残っていたゴミデータをクリアする
      sfValues[i][indices.status] = "";
      sfValues[i][indices.url] = "";
    }
  }
  
  // メモリ上で修復・更新を行ったため、最終的にシートへ書き戻すフラグを立てておく
  env.hasUpdates = true; 
}

/**
 * グループの日付情報から処理対象の月リストを生成する
 */
function buildMonthList(group) {
  let monthList = [];
  if (group.rawStart && group.rawEnd) {
    let sDate = parseSafeDate(group.rawStart); 
    let eDate = parseSafeDate(group.rawEnd);
    if (sDate && eDate) {
      let currentMonth = new Date(sDate.getTime()); 
      currentMonth.setDate(1);
      let endMonth = new Date(eDate.getTime()); 
      endMonth.setDate(1);
      while (currentMonth <= endMonth) {
        monthList.push(Utilities.formatDate(currentMonth, Session.getScriptTimeZone(), "yyyyMM"));
        currentMonth.setMonth(currentMonth.getMonth() + 1);
      }
    }
  }
  return monthList;
}

/**
 * フォルダURLの有効性を検証し、無効であればエラー記録を行う
 * ※既存フォルダの名前が異なる場合はここで自動リネームが実行される
 * @returns {boolean} 有効に処理を続行できる場合はtrue、無効（スキップすべき）場合はfalse
 */
function checkAndFixUrl(env, folderUrlObj, layer1Name) {
  if (!folderUrlObj.url) return true;
  
  const folderId = extractCleanDriveId_(folderUrlObj.url);
  if (!folderId) return true;
  
  if (env.skipCacheMap[folderId]) {
    folderUrlObj.url = ""; 
    return true;
  }
  
  try {
    let existingFolder = DriveApp.getFolderById(folderId);
    if (existingFolder.isTrashed()) {
      env.newErrors.push([folderId]); 
      folderUrlObj.url = ""; // ゴミ箱にある場合はURLをクリアして新規作成へフォールバック
    } else {
      // 💡 リネーム処理: 現在のフォルダ名とマスタから生成した期待値(layer1Name)が異なれば更新
      if (existingFolder.getName() !== layer1Name) {
        existingFolder.setName(layer1Name);
      }
    }
    return true;
  } catch (e) {
    env.newErrors.push([folderId]); 
    folderUrlObj.url = ""; 
    return true;
  }
}

/**
 * 単一のグループ（商談）に対してフォルダを生成する (ゴミ箱検証付き)
 */
function executeFolderCreationForGroup(env, groupGeneratedData) {
  let currentLayer1Url = "";
  let newFolders = [];
  const currentGroup = groupGeneratedData[0]._groupRef;
  let seenLayer1 = new Set();
  
  for (let i = 0; i < groupGeneratedData.length; i++) {
    const row = groupGeneratedData[i].slice(1).filter(cell => typeof cell !== 'object');
    let folder = currentGroup.isKamiki ? env.folder_root_kamiki : env.folder_root_shimoki;
    let currentPath = folder.getId();
    let isNewLayer1 = false;

    for (let j = 0; j < row.length; j++) {
      if (row[j] === "") continue;
      
      let folder_name = String(row[j]).trim();
      if (!folder_name) continue;

      currentPath += "/" + folder_name;
      
      if (j === 2 && currentGroup.folderUrl) {
        const folderId = extractCleanDriveId_(currentGroup.folderUrl);
        if (folderId && env.folderCache[folderId]) {
           folder = env.folderCache[folderId]; 
           currentPath = folderId; 
           currentLayer1Url = folder.getUrl(); 
           continue;
        }
      }

      if (env.folderCache[currentPath]) {
        folder = env.folderCache[currentPath];
      } else {
        let folders = folder.getFoldersByName(folder_name);
        let foundFolder = null;
        while (folders.hasNext()) {
          let f = folders.next();
          if (!f.isTrashed()) { 
            foundFolder = f; 
            break; 
          }
        }
        
        if (foundFolder) {
          folder = foundFolder;
        } else {
          folder = folder.createFolder(folder_name);
          if (j === 2) isNewLayer1 = true; 
        }
        
        env.folderCache[currentPath] = folder;
        if (j === 2) env.folderCache[folder.getId()] = folder;
      }
      
      if (j === 2) {
        currentLayer1Url = folder.getUrl();
        if (isNewLayer1 && !seenLayer1.has(folder_name)) {
          newFolders.push({ name: folder_name, url: currentLayer1Url });
          seenLayer1.add(folder_name);
        }
      }
    }
  }
  return { layer1Url: currentLayer1Url, newFolders: newFolders };
}

/**
 * 新たに検知したエラー（無効URLやスキップキー）をキャッシュシートに書き出す
 */
function flushBadUrls(env) {
  if (env.newErrors && env.newErrors.length > 0) {
    const uniqueIds = [...new Set(env.newErrors.map(e => e[0]))];
    const appendData = uniqueIds.map(id => [id]);
    const lastRow = env.errorCacheSheet.getLastRow();
    env.errorCacheSheet.getRange(lastRow + 1, 1, appendData.length, 1).setValues(appendData);
    env.newErrors = []; 
    SpreadsheetApp.flush();
  }
}

/**
 * ルートフォルダを安全に取得または作成する (ゴミ箱チェック付き)
 */
function getOrCreateRootFolder(ui, url, name, label) {
  if (!url || url === "ここに入力" || !name) {
    if (ui) ui.alert(`raw_folderシートの【${label}】用URLまたはフォルダ名が未入力です。`); 
    return null;
  }
  const folderId = extractCleanDriveId_(url) || url;
  
  try {
    let parentFolder = DriveApp.getFolderById(folderId);
    if (parentFolder.isTrashed()) return null;
    let targetFolders = parentFolder.getFoldersByName(name);
    while (targetFolders.hasNext()) {
      let f = targetFolders.next();
      if (!f.isTrashed()) return f;
    }
    return parentFolder.createFolder(name);
  } catch (e) {
    if (ui) ui.alert(`raw_folderシートの【${label}】用URLが不正、またはアクセス権がありません。`); 
    return null;
  }
}

/**
