/**
 * 過去の履歴(log_SF)と現在のメタデータ(ProjectCode/商談名)、
 * および「SF側で事後的に手動入力・削除されたURL」を比較し、
 * 更新フラグ（リセット要求含む）を判定する。
 */
function healRawDataWithLog_(env) {
  const { sfValues, logData, indices } = env;
  if (!logData || logData.length <= 1) return; 

  const logHeaders = logData[0];
  const logIdx = {
    oppId: logHeaders.findIndex(h => String(h).replace(/\s/g, "").includes("商談ID") || String(h).replace(/\s/g, "").toLowerCase().includes("opportunityid")),
    pCode: logHeaders.findIndex(h => String(h).replace(/\s/g, "").toLowerCase().includes("projectcode") || String(h).replace(/\s/g, "").includes("プロジェクトコード")),
    name: logHeaders.findIndex(h => String(h).replace(/\s/g, "").includes("商谈名") || String(h).replace(/\s/g, "").includes("商談名")),
    status: logHeaders.indexOf("自動作成ステータス"),
    url: logHeaders.indexOf("格納先フォルダURL")
  };

  if (logIdx.oppId === -1) return; 

  const logMap = {};
  for (let r = 1; r < logData.length; r++) {
    const oppId = String(logData[r][logIdx.oppId]).trim();
    if (oppId) {
      logMap[oppId] = {
        status: logIdx.status !== -1 ? (logData[r][logIdx.status] || "") : "",
        url: logIdx.url !== -1 ? (logData[r][logIdx.url] || "") : "",
        pCode: logIdx.pCode !== -1 ? String(logData[r][logIdx.pCode]).trim() : "",
        name: logIdx.name !== -1 ? String(logData[r][logIdx.name]).trim() : ""
      };
    }
  }

  for (let i = 1; i < sfValues.length; i++) {
    const oppId = String(sfValues[i][indices.oppId]).trim();
    if (!oppId) continue;

    if (logMap[oppId]) {
      const rawPCode = indices.pCode !== -1 ? String(sfValues[i][indices.pCode]).trim() : "";
      const rawName = indices.name !== -1 ? String(sfValues[i][indices.name]).trim() : "";
      
      const rawSfStorageUrl = (indices.sfStorageUrl !== -1 && sfValues[i][indices.sfStorageUrl]) ? String(sfValues[i][indices.sfStorageUrl]).trim() : "";
      const rawUrlCol = (indices.url !== -1 && sfValues[i][indices.url]) ? String(sfValues[i][indices.url]).trim() : "";
      
      const logPCode = logMap[oppId].pCode;
      const logName = logMap[oppId].name;
      const logUrl = logMap[oppId].url;

      const cleanLogUrl = logUrl ? extractCleanDriveId_(logUrl) : "";
      const combinedRawUrl = rawSfStorageUrl || rawUrlCol;
      const cleanRawUrl = combinedRawUrl ? extractCleanDriveId_(combinedRawUrl) : "";

      let isIntentionalReset = false;
      let isManualUrlUpdated = false;

      // 意図的なリセット操作（空欄戻し）の検知
      if (cleanLogUrl) {
          if (!rawSfStorageUrl && !rawUrlCol) {
              isIntentionalReset = true;
          } else if (cleanRawUrl && cleanRawUrl !== cleanLogUrl) {
              isManualUrlUpdated = true;
          }
      } else {
          if (cleanRawUrl) isManualUrlUpdated = true;
      }

      if (rawPCode !== logPCode || rawName !== logName || isManualUrlUpdated || isIntentionalReset) {
        if (isIntentionalReset) {
            sfValues[i][indices.status] = "リセット要求";
            sfValues[i][indices.url] = "";
        } else {
            sfValues[i][indices.status] = ""; 
            sfValues[i][indices.url] = logMap[oppId].url; 
        }
      } else {
        sfValues[i][indices.status] = logMap[oppId].status;
        sfValues[i][indices.url] = logMap[oppId].url;
      }
    } else {
      sfValues[i][indices.status] = "";
      sfValues[i][indices.url] = "";
    }
  }
  
  env.hasUpdates = true; 
}

function buildMonthList(group) {
  let monthList = [];
  if (group.rawStart && group.rawEnd) {
    let sDate = parseSafeDate(group.rawStart); 
    let eDate = parseSafeDate(group.rawEnd);
    if (sDate && eDate) {
      let currentMonth = new Date(sDate.getTime()); 
      currentMonth.setDate(1);
      let endMonth = new Date(eDate.getTime()); 
      endMonth.setDate(1);
      while (currentMonth <= endMonth) {
        monthList.push(Utilities.formatDate(currentMonth, Session.getScriptTimeZone(), "yyyyMM"));
        currentMonth.setMonth(currentMonth.getMonth() + 1);
      }
    }
  }
  return monthList;
}

function checkAndFixUrl(env, group, layer1Name) {
  if (!group.folderUrl) return { isValid: true, status: "" };
  
  const folderId = extractCleanDriveId_(group.folderUrl);
  if (!folderId) return { isValid: true, status: "" };
  
  if (env.skipCacheMap[folderId]) {
    group.folderUrl = ""; 
    return { isValid: true, status: "" };
  }
  
  try {
    let existingFolder = DriveApp.getFolderById(folderId);
    if (existingFolder.isTrashed()) {
      group.folderUrl = ""; 
      return { isValid: true, status: "" };
    } 
    
    let parentName = "";
    const parents = existingFolder.getParents();
    if (parents.hasNext()) {
      parentName = parents.next().getName();
    }
    
    if (parentName !== group.deptName) {
      console.warn(`階層不一致を検知: 期待値[${group.deptName}], 実際[${parentName}]`);
      return { isValid: false, status: "エラー(階層不一致: 計上部署名相違)" };
    }

    if (existingFolder.getName() !== layer1Name) {
      existingFolder.setName(layer1Name);
    }
    
    return { isValid: true, status: "" };
  } catch (e) {
    group.folderUrl = ""; 
    return { isValid: true, status: "" };
  }
}

function executeFolderCreationForGroup(env, groupGeneratedData) {
  let currentLayer1Url = "";
  let newFolders = [];
  const currentGroup = groupGeneratedData[0]._groupRef;
  let seenLayer1 = new Set();
  
  for (let i = 0; i < groupGeneratedData.length; i++) {
    const row = groupGeneratedData[i].slice(1).filter(cell => typeof cell !== 'object');
    let folder = currentGroup.isKamiki ? env.folder_root_kamiki : env.folder_root_shimoki;
    let currentPath = folder.getId();
    let isNewLayer1 = false;

    for (let j = 0; j < row.length; j++) {
      if (row[j] === "") continue;
      
      let folder_name = String(row[j]).trim();
      if (!folder_name) continue;

      currentPath += "/" + folder_name;
      
      if (j === 2 && currentGroup.folderUrl) {
        const folderId = extractCleanDriveId_(currentGroup.folderUrl);
        if (folderId) {
           try {
             if (env.folderCache[folderId]) {
               folder = env.folderCache[folderId]; 
             } else {
               folder = DriveApp.getFolderById(folderId);
               env.folderCache[folderId] = folder;
             }
             currentPath = folderId; 
             currentLayer1Url = folder.getUrl(); 
             continue;
           } catch (e) {
             console.warn("K列のURL( " + folderId + " )へのアクセスに失敗しました。名前検索・新規作成へフォールバックします: " + e.message);
           }
        }
      }

      if (env.folderCache[currentPath]) {
        folder = env.folderCache[currentPath];
      } else {
        let folders = folder.getFoldersByName(folder_name);
        let foundFolder = null;
        while (folders.hasNext()) {
          let f = folders.next();
          if (!f.isTrashed()) { 
            foundFolder = f; 
            break; 
          }
        }
        
        if (foundFolder) {
          folder = foundFolder;
        } else {
          folder = folder.createFolder(folder_name);
          if (j === 2) isNewLayer1 = true; 
        }
        
        env.folderCache[currentPath] = folder;
        if (j === 2) env.folderCache[folder.getId()] = folder;
      }
      
      if (j === 2) {
        currentLayer1Url = folder.getUrl();
        if (isNewLayer1 && !seenLayer1.has(folder_name)) {
          newFolders.push({ name: folder_name, url: currentLayer1Url });
          seenLayer1.add(folder_name);
        }
      }
    }
  }
  return { layer1Url: currentLayer1Url, newFolders: newFolders };
}

function flushBadUrls(env) {
  if (env.newErrors && env.newErrors.length > 0) {
    const uniqueIds = [...new Set(env.newErrors.map(e => e[0]))];
    const appendData = uniqueIds.map(id => [id]);
    const lastRow = env.errorCacheSheet.getLastRow();
    env.errorCacheSheet.getRange(lastRow + 1, 1, appendData.length, 1).setValues(appendData);
    env.newErrors = []; 
    SpreadsheetApp.flush();
  }
}

function getOrCreateRootFolder(ui, url, name, label) {
  if (!url || url === "ここに入力" || !name) {
    if (ui) ui.alert(`raw_folderシートの【${label}】用URLまたはフォルダ名が未入力です。`); 
    return null;
  }
  const folderId = extractCleanDriveId_(url) || url;
  
  try {
    let parentFolder = DriveApp.getFolderById(folderId);
    if (parentFolder.isTrashed()) return null;
    let targetFolders = parentFolder.getFoldersByName(name);
    while (targetFolders.hasNext()) {
      let f = targetFolders.next();
      if (!f.isTrashed()) return f;
    }
    return parentFolder.createFolder(name);
  } catch (e) {
    if (ui) ui.alert(`raw_folderシートの【${label}】用URLが不正、またはアクセス権がありません。`); 
    return null;
  }
}

function initializeAutoEnvironment(ui, startTime) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const mainSheet = ss.getSheetByName(CONFIG.SHEET_WORKSPACE);
  const masterSheet = ss.getSheetByName(CONFIG.SHEET_MASTER);
  const rawFolderSheet = ss.getSheetByName(CONFIG.SHEET_RAW_FOLDER);
  const sfSheet = ss.getSheetByName(CONFIG.SHEET_SF);
  let logSheet = ss.getSheetByName(CONFIG.SHEET_LOG) || ss.insertSheet(CONFIG.SHEET_LOG);

  if (!mainSheet || !masterSheet || !rawFolderSheet || !sfSheet) return null;

  const url_kamiki = rawFolderSheet.getRange("B1").getValue().toString().trim();
  const name_kamiki = rawFolderSheet.getRange("B2").getValue().toString().trim();
  const url_shimoki = rawFolderSheet.getRange("B3").getValue().toString().trim();
  const name_shimoki = rawFolderSheet.getRange("B4").getValue().toString().trim();

  const folder_root_kamiki = getOrCreateRootFolder(ui, url_kamiki, name_kamiki, "上期");
  const folder_root_shimoki = getOrCreateRootFolder(ui, url_shimoki, name_shimoki, "下期");
  if (!folder_root_kamiki || !folder_root_shimoki) return null; 

  let errorCacheSheet = ss.getSheetByName(CONFIG.SHEET_ERROR_CACHE);
  if (!errorCacheSheet) {
    errorCacheSheet = ss.insertSheet(CONFIG.SHEET_ERROR_CACHE);
    errorCacheSheet.hideSheet(); 
    errorCacheSheet.getRange("A1").setValue("無効キャッシュキー");
    errorCacheSheet.setFrozenRows(1);
  }

  let skipCacheMap = {};
  const cacheLastRow = errorCacheSheet.getLastRow();
  if (cacheLastRow > 1) {
    const cacheData = errorCacheSheet.getRange(2, 1, cacheLastRow - 1, 1).getValues();
    cacheData.forEach(row => { 
      if (row[0]) {
        let key = String(row[0]).trim();
        if (!key.startsWith("2F") && !key.startsWith("3D")) {
          skipCacheMap[key] = true; 
        }
      }
    });
  }

  const sfData = sfSheet.getDataRange().getValues();
  const headers = sfData[0];
  const indices = {
    oppId: headers.findIndex(h => String(h).replace(/\s/g, "").includes("商談ID") || String(h).replace(/\s/g, "").toLowerCase().includes("opportunityid")),
    pCode: headers.findIndex(h => String(h).replace(/\s/g, "").toLowerCase().includes("projectcode") || String(h).replace(/\s/g, "").includes("プロジェクトコード")),
    name: headers.findIndex(h => String(h).replace(/\s/g, "").includes("商谈名") || String(h).replace(/\s/g, "").includes("商談名")),
    start: headers.findIndex(h => String(h).replace(/\s/g, "").includes("売上開始月")),
    end: headers.findIndex(h => String(h).replace(/\s/g, "").includes("売上終了月")),
    product: headers.findIndex(h => String(h).replace(/\s/g, "").includes("商品")),
    supplier: headers.findIndex(h => String(h).replace(/\s/g, "").includes("仕入先")),
    bu: headers.findIndex(h => String(h).replace(/\s/g, "").toLowerCase().includes("businessunit")),
    dept: headers.findIndex(h => String(h).replace(/\s/g, "").includes("計上部署")),
    sfStorageUrl: headers.findIndex(h => String(h).replace(/\s/g, "").includes("ファイルストレージ(URL)")),
    status: headers.indexOf("自動作成ステータス"),
    url: headers.indexOf("格納先フォルダURL")
  };

  if (indices.oppId === -1 || indices.name === -1 || indices.start === -1) {
    const errorMsg = "🚨【致命的エラー】Salesforceのデータに必須項目（「商談ID」「商談名」「売上開始月」のいずれか）が含まれていません。\nレポートの出力形式や貼り付けミスがないか確認してください。\n※データ汚染を防ぐため、処理を安全に強制停止しました。";
    if (ui) ui.alert(errorMsg);
    console.error(errorMsg);
    return null;
  }

  if (indices.status === -1) {
    indices.status = headers.length;
    sfSheet.getRange(1, indices.status + 1).setValue("自動作成ステータス"); 
    headers.push("自動作成ステータス");
    for (let i = 1; i < sfData.length; i++) sfData[i].push("");
  }
  
  if (indices.url === -1) {
    indices.url = headers.length;
    sfSheet.getRange(1, indices.url + 1).setValue("格納先フォルダURL"); 
    headers.push("格納先フォルダURL");
    for (let i = 1; i < sfData.length; i++) sfData[i].push("");
  }

  return { 
    ss, mainSheet, sfSheet, logSheet, errorCacheSheet, 
    sfData, logData: logSheet.getDataRange().getValues(), masterData: masterSheet.getDataRange().getValues(), 
    headers, indices, folder_root_kamiki, folder_root_shimoki, startTime, 
    skipCacheMap, newErrors: [], sfValues: sfData.map(r => [...r]), hasUpdates: false, folderCache: {}
  };
}

function buildLogDataMaps(logData) {
  const logSet = new Set();
  const logUrlMap = {}; 
  if (logData.length <= 1) return { logSet, logUrlMap };
  
  const idx = {
    oppId: logData[0].findIndex(h => String(h).replace(/\s/g, "").includes("商談ID") || String(h).replace(/\s/g, "").toLowerCase().includes("opportunityid")),
    pCode: logData[0].findIndex(h => String(h).replace(/\s/g, "").toLowerCase().includes("projectcode")),
    name: logData[0].findIndex(h => String(h).replace(/\s/g, "").includes("商談名")),
    start: logData[0].findIndex(h => String(h).replace(/\s/g, "").includes("売上開始月")),
    end: logData[0].findIndex(h => String(h).replace(/\s/g, "").includes("売上終了月")),
    product: logData[0].findIndex(h => String(h).replace(/\s/g, "").includes("商品")),
    supplier: logData[0].findIndex(h => String(h).replace(/\s/g, "").includes("仕入先")),
    url: logData[0].indexOf("格納先フォルダURL") 
  };
  
  for (let i = 1; i < logData.length; i++) {
    const p = idx.pCode !== -1 ? formatCompareValue(logData[i][idx.pCode]) : "";
    const n = idx.name !== -1 ? formatCompareValue(logData[i][idx.name]) : "";
    const s = idx.start !== -1 ? formatCompareValue(logData[i][idx.start]) : "";
    const e = idx.end !== -1 ? formatCompareValue(logData[i][idx.end]) : "";
    const pr = idx.product !== -1 ? formatCompareValue(logData[i][idx.product]) : "";
    const su = idx.supplier !== -1 ? formatCompareValue(logData[i][idx.supplier]) : "";
    
    logSet.add(`${p}🏎️${n}🏎️${s}🏎️${e}🏎️${pr}🏎️${su}`);
    
    if (idx.oppId !== -1 && idx.url !== -1) {
      const oppIdStr = String(logData[i][idx.oppId]).trim(); 
      const urlStr = String(logData[i][idx.url]).trim();
      if (oppIdStr && urlStr) logUrlMap[oppIdStr] = urlStr;
    }
  }
  return { logSet, logUrlMap };
}

/**
 * 修復済みの全行データをスキャンし、処理が必要なタスク（To-Doリスト）を抽出する
 */
function parseSfDataAndDetectChangesAll(env, logSet, logUrlMap) {
  const { sfValues, indices } = env;
  const groups = {};
  const duplicateUrlMap = {}; 
  const newDuplicateUrls = new Set(); 

  // 重複チェック用マップ作成
  for (let i = 1; i < sfValues.length; i++) {
    const oppId = String(sfValues[i][indices.oppId]).trim();
    if (!oppId) continue;
    
    // ★v2.0.11 追加: 商談名を取得し、未設定の場合はプレースホルダを代入
    const oppName = sfValues[i][indices.name] ? String(sfValues[i][indices.name]).trim() : "商談名未設定";

    let rawSfStorageUrl = (indices.sfStorageUrl !== -1 && sfValues[i][indices.sfStorageUrl]) ? String(sfValues[i][indices.sfStorageUrl]).trim() : "";
    if (rawSfStorageUrl) {
      const extractedId = extractCleanDriveId_(rawSfStorageUrl);
      rawSfStorageUrl = extractedId ? "https://drive.google.com/drive/folders/" + extractedId : "";
    }
    
    let determinedUrl = rawSfStorageUrl || logUrlMap[oppId] || "";
    
    if (sfValues[i][indices.status] === "リセット要求") {
      determinedUrl = "";
    }

    if (determinedUrl) {
      if (!duplicateUrlMap[determinedUrl]) duplicateUrlMap[determinedUrl] = new Set();
      // ★v2.0.11 修正: 商談ID単体ではなく「商談名（商談ID）」として記録
      duplicateUrlMap[determinedUrl].add(`${oppName}（${oppId}）`);
    }
  }

  // To-Doリスト抽出・差分ステータス更新
  for (let i = 1; i < sfValues.length; i++) {
    const oppId = String(sfValues[i][indices.oppId]).trim();
    const oppName = sfValues[i][indices.name];
    if (!oppName) continue;

    const rawStart = sfValues[i][indices.start];
    const startDate = parseSafeDate(rawStart);
    if (!startDate) {
      if (sfValues[i][indices.status] !== "エラー(開始月未入力)") {
        sfValues[i][indices.status] = "エラー(開始月未入力)";
        env.hasUpdates = true;
      }
      continue; 
    }

    let pCode = sfValues[i][indices.pCode] ? String(sfValues[i][indices.pCode]).trim() : "SFXXXXXXXX";
    const groupKey = oppId ? "OPPID_" + oppId : "PJC_" + pCode + "_" + oppName.replace(/\s/g, "");

    if (env.skipCacheMap[groupKey]) continue;

    let rawSfStorageUrl = (indices.sfStorageUrl !== -1 && sfValues[i][indices.sfStorageUrl]) ? String(sfValues[i][indices.sfStorageUrl]).trim() : "";
    if (rawSfStorageUrl) {
      const extractedId = extractCleanDriveId_(rawSfStorageUrl);
      rawSfStorageUrl = extractedId ? "https://drive.google.com/drive/folders/" + extractedId : "";
    }
    
    let determinedUrl = rawSfStorageUrl || logUrlMap[oppId] || "";
    
    if (sfValues[i][indices.status] === "リセット要求") {
      determinedUrl = "";
      sfValues[i][indices.status] = ""; 
    }

    if (determinedUrl && duplicateUrlMap[determinedUrl] && duplicateUrlMap[determinedUrl].size > 1) {
      const previousUrlInLog = logUrlMap[oppId] || "";
      const currentStatus = sfValues[i][indices.status] ? String(sfValues[i][indices.status]).trim() : "";

      if (previousUrlInLog === determinedUrl && (currentStatus === "完了" || currentStatus === "対象外")) {
          continue;
      } else if (currentStatus === "エラー(URL重複)") {
          continue;
      } else {
          sfValues[i][indices.status] = "エラー(URL重複)";
          sfValues[i][indices.url] = determinedUrl; 
          env.hasUpdates = true;
          newDuplicateUrls.add(determinedUrl); 
          continue; 
      }
    }

    const cleanId = extractCleanDriveId_(determinedUrl);
    if (cleanId && env.skipCacheMap[cleanId]) continue;

    const existingStatus = sfValues[i][indices.status] ? String(sfValues[i][indices.status]).trim() : "";
    
    if (!groups[groupKey]) {
      const month = startDate.getMonth() + 1; 
      const isKamikiFlag = (month >= 4 && month <= 9);

      groups[groupKey] = {
        projectCode: pCode, 
        oppName: oppName, 
        buName: String(sfValues[i][indices.bu]).trim() || "BU未指定", 
        deptName: String(sfValues[i][indices.dept]).trim() || "部署未指定",
        supplierA: [], 
        supplierB: [], 
        rawStart: rawStart, 
        rawEnd: sfValues[i][indices.end] || null,
        rowIndexes: [], 
        folderUrl: determinedUrl, 
        isChanged: false, 
        isKamiki: isKamikiFlag 
      };
    }
    
    groups[groupKey].rowIndexes.push(i + 1);

    const prodVal = indices.product !== -1 ? formatCompareValue(sfValues[i][indices.product]) : "";
    const suppVal = indices.supplier !== -1 ? formatCompareValue(sfValues[i][indices.supplier]) : "";

    if (suppVal) {
      if (/[BＢ]/.test(prodVal)) { 
        if (!groups[groupKey].supplierB.includes(suppVal)) groups[groupKey].supplierB.push(suppVal); 
      } else { 
        if (!groups[groupKey].supplierA.includes(suppVal)) groups[groupKey].supplierA.push(suppVal); 
      }
    }
    
    let needsProcess = false;
    if (existingStatus === "完了" || existingStatus === "対象外" || existingStatus.includes("エラー")) {
      needsProcess = false; 
    } else {
      needsProcess = true;  
    }

    if (needsProcess) {
      groups[groupKey].isChanged = true;
    }
  }

  const duplicateErrors = [];
  newDuplicateUrls.forEach(url => {
    // ★v2.0.11 キー名を oppDetails に変更
    duplicateErrors.push({ url: url, oppDetails: Array.from(duplicateUrlMap[url]) });
  });
  
  return { groups, duplicateErrors };
}

function writeWorkspaceData(mainSheet, allGeneratedData) {
  if (!allGeneratedData || allGeneratedData.length === 0) return;

  const lastRow = mainSheet.getLastRow();
  const startRow = Math.max(CONFIG.START_ROW, lastRow + 1);

  const maxCol = Math.max(...allGeneratedData.map(row => row.filter(cell => typeof cell !== 'object').length));
  const formattedData = allGeneratedData.map(row => {
    let newRow = row.filter(cell => typeof cell !== 'object');
    while (newRow.length < maxCol) newRow.push(""); 
    return newRow;
  });

  mainSheet.getRange(startRow, 1, formattedData.length, maxCol).setValues(formattedData);
}

// =========================================================
// 【raw_SF書き戻し】商談ID基準の安全なマージ書き込み
// =========================================================
/**
 * raw_SFへの書き戻しを、GASが担当する「自動作成ステータス」「格納先フォルダURL」の2列に限定し、
 * かつ商談ID基準で対象行を再特定してから反映する。
 * これにより、Salesforceコネクタ側で行の並び順や件数が変わっていても、
 * A〜K列（Salesforceレポート由来の列）を誤って古い内容で上書きすることを防ぐ。
 * 商談IDが空欄の行（紐づく実データが存在しない残留行）は、ステータス・URLをクリアする。
 * @param {Object} env - initializeAutoEnvironmentが返す実行コンテキスト
 * @returns {Array<Array<any>>} 反映後の最新シート全内容（log_SF保存等で再利用可能）
 */
function persistStatusAndUrlByOppId_(env) {
  const freshData = env.sfSheet.getDataRange().getValues();
  if (freshData.length === 0) return freshData;

  // 現在のシート上での「商談ID → 行インデックス（0始まり、freshData基準）」マップを構築
  const oppIdToRows = {};
  for (let i = 1; i < freshData.length; i++) {
    const oppId = String(freshData[i][env.indices.oppId] || "").trim();
    if (!oppId) continue;
    if (!oppIdToRows[oppId]) oppIdToRows[oppId] = [];
    oppIdToRows[oppId].push(i);
  }

  const mergedData = freshData.map(row => [...row]);

  // 商談IDが空欄の行は、紐づく実データが存在しないためステータス・URLをクリアする
  for (let i = 1; i < mergedData.length; i++) {
    const oppId = String(freshData[i][env.indices.oppId] || "").trim();
    if (!oppId) {
      mergedData[i][env.indices.status] = "";
      mergedData[i][env.indices.url] = "";
    }
  }

  // 今回の実行結果（env.sfValues）を、商談ID基準で現在のシート行に適用する
  const appliedOppIds = new Set();
  for (let i = 1; i < env.sfValues.length; i++) {
    const oppId = String(env.sfValues[i][env.indices.oppId] || "").trim();
    if (!oppId || appliedOppIds.has(oppId)) continue;
    appliedOppIds.add(oppId);

    const targetRows = oppIdToRows[oppId];
    if (!targetRows || targetRows.length === 0) {
      // 現在のシートにこの商談IDが見つからない（削除・大幅な入替等）場合は反映せずスキップ
      continue;
    }

    const newStatus = env.sfValues[i][env.indices.status];
    const newUrl = env.sfValues[i][env.indices.url];
    targetRows.forEach(r => {
      mergedData[r][env.indices.status] = newStatus;
      mergedData[r][env.indices.url] = newUrl;
    });
  }

  const numRows = mergedData.length;
  env.sfSheet.getRange(1, env.indices.status + 1, numRows, 1)
    .setValues(mergedData.map(row => [row[env.indices.status]]));
  env.sfSheet.getRange(1, env.indices.url + 1, numRows, 1)
    .setValues(mergedData.map(row => [row[env.indices.url]]));

  return mergedData;
}

function finalizeSuccess(env, createdCount, totalRows, ui, duplicateErrors = [], isAlreadyDone = false) {
  const finalData = env.sfSheet.getDataRange().getValues(); 
  saveLogSheetSafely_(env.logSheet, finalData);
  
  let msg = "";
  if (isAlreadyDone) {
    msg = `🎉 全データチェック完了（計 ${totalRows} 行）\n新しい差分や未処理の案件はありませんでした。`;
  } else {
    msg = `🎉 全データ処理完了（計 ${totalRows} 行）\n新たに ${createdCount} 個のフォルダを差分作成・ステータス更新しました。`;
  }
  
  if (ui) ui.alert(msg); 
  else console.log(msg);
}

/**
 * log_SFへ内容を安全に保存する。行・列を問わず余分な残留データが残らないよう、
 * 既存の使用範囲を一度クリアしてから新しい内容を書き込む。
 * @param {GoogleAppsScript.Spreadsheet.Sheet} logSheet - 保存先のログシート
 * @param {Array<Array<any>>} data - 書き込むデータ
 */
function saveLogSheetSafely_(logSheet, data) {
  try {
    if (!logSheet || !data || !Array.isArray(data) || data.length === 0 || !data[0] || !Array.isArray(data[0]) || data[0].length === 0) {
      console.warn("saveLogSheetSafely_: 書き込み対象データが存在しないか不正な構造のためスキップしました。");
      return;
    }

    // 行・列どちらの余りも確実に防ぐため、既存の使用範囲を一度クリアしてから書き込む
    const existingRange = logSheet.getDataRange();
    if (existingRange) {
      existingRange.clearContent();
    }

    logSheet.getRange(1, 1, data.length, data[0].length).setValues(data);
    SpreadsheetApp.flush();
  } catch (err) {
    console.error("saveLogSheetSafely_ 実行時に例外が発生しましたが、基本保存は完了しています: " + err.message);
  }
}
