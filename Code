function getOrCreateRootFolder(ui, url, name, label) {
  if (!url || url === "ここに入力" || !name) {
    if (ui) ui.alert(`raw_folderシートの【${label}】用URLまたはフォルダ名が未入力です。`);
    return null;
  }
  const match = url.match(/[-\w]{25,}/);
  if (match) url = match[0];
  
  let parentFolder;
  try {
    parentFolder = DriveApp.getFolderById(url);
  } catch (e) {
    if (ui) ui.alert(`raw_folderシートの【${label}】用URLが正しくありません。`);
    return null;
  }

  let targetFolders = parentFolder.getFoldersByName(name);
  return targetFolders.hasNext() ? targetFolders.next() : parentFolder.createFolder(name);
}

function initializeAutoEnvironment(ui) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const mainSheet = ss.getSheetByName(CONFIG.SHEET_WORKSPACE);
  const masterSheet = ss.getSheetByName(CONFIG.SHEET_MASTER);
  const rawFolderSheet = ss.getSheetByName(CONFIG.SHEET_RAW_FOLDER);
  const sfSheet = ss.getSheetByName(CONFIG.SHEET_SF);
  let logSheet = ss.getSheetByName(CONFIG.SHEET_LOG) || ss.insertSheet(CONFIG.SHEET_LOG);

  if (!mainSheet || !masterSheet || !rawFolderSheet || !sfSheet) {
    const msg = "必要なシートが見つかりません。設定を確認してください。";
    if (ui) ui.alert(msg); else console.error(msg);
    return null;
  }

  const url_kamiki = rawFolderSheet.getRange("B1").getValue().toString().trim();
  const name_kamiki = rawFolderSheet.getRange("B2").getValue().toString().trim();
  const url_shimoki = rawFolderSheet.getRange("B3").getValue().toString().trim();
  const name_shimoki = rawFolderSheet.getRange("B4").getValue().toString().trim();

  const folder_root_kamiki = getOrCreateRootFolder(ui, url_kamiki, name_kamiki, "上期(B1/B2)");
  const folder_root_shimoki = getOrCreateRootFolder(ui, url_shimoki, name_shimoki, "下期(B3/B4)");

  if (!folder_root_kamiki || !folder_root_shimoki) return null; 

  const lastRow = mainSheet.getLastRow();
  if (lastRow >= CONFIG.START_ROW) {
    mainSheet.getRange(CONFIG.START_ROW, 1, lastRow - (CONFIG.START_ROW - 1), mainSheet.getLastColumn()).clearContent();
  }

  const sfData = sfSheet.getDataRange().getValues();
  const logData = logSheet.getDataRange().getValues();
  const masterData = masterSheet.getDataRange().getValues();
  const headers = sfData[0];

  const indices = {
    oppId: headers.findIndex(h => String(h).replace(/\s/g, "").includes("商談ID") || String(h).replace(/\s/g, "").toLowerCase().includes("opportunityid")),
    pCode: headers.findIndex(h => String(h).replace(/\s/g, "").toLowerCase().includes("projectcode") || String(h).replace(/\s/g, "").includes("プロジェクトコード")),
    name: headers.findIndex(h => String(h).replace(/\s/g, "").includes("商谈名") || String(h).replace(/\s/g, "").includes("商談名")),
    start: headers.findIndex(h => String(h).replace(/\s/g, "").includes("売上開始月")),
    end: headers.findIndex(h => String(h).replace(/\s/g, "").includes("売上終了月")),
    product: headers.findIndex(h => String(h).replace(/\s/g, "").includes("商品")),
    supplier: headers.findIndex(h => String(h).replace(/\s/g, "").includes("仕入先")),
    bu: headers.findIndex(h => String(h).replace(/\s/g, "").toLowerCase().includes("businessunit")),
    dept: headers.findIndex(h => String(h).replace(/\s/g, "").includes("計上部署")),
    // ★追加: Salesforce連携のファイルストレージ(URL)の列を取得
    sfStorageUrl: headers.findIndex(h => String(h).replace(/\s/g, "").includes("ファイルストレージ(URL)")),
    status: headers.indexOf("自動作成ステータス"),
    url: headers.indexOf("格納先フォルダURL")
  };

  if (indices.oppId === -1 || indices.pCode === -1 || indices.name === -1 || indices.bu === -1 || indices.dept === -1) {
    if (ui) ui.alert("必須列が見つかりません。処理を中断します。");
    return null;
  }

  if (indices.status === -1) {
    indices.status = headers.length;
    sfSheet.getRange(1, indices.status + 1).setValue("自動作成ステータス");
  }

  if (indices.url === -1) {
    indices.url = sfSheet.getLastColumn();
    sfSheet.getRange(1, indices.url + 1).setValue("格納先フォルダURL");
    sfData[0][indices.url] = "格納先フォルダURL";
  }

  return { 
    ss, mainSheet, sfSheet, logSheet, sfData, logData, masterData, headers, indices, 
    folder_root_kamiki, folder_id_root_kamiki: folder_root_kamiki.getId(),
    folder_root_shimoki, folder_id_root_shimoki: folder_root_shimoki.getId()
  };
}

function buildLogDataMaps(logData) {
  const logSet = new Set();
  const logUrlMap = {}; 
  
  if (logData.length <= 1) return { logSet, logUrlMap };

  const logHeaders = logData[0];
  const idx = {
    oppId: logHeaders.findIndex(h => String(h).replace(/\s/g, "").includes("商談ID") || String(h).replace(/\s/g, "").toLowerCase().includes("opportunityid")),
    pCode: logHeaders.findIndex(h => String(h).replace(/\s/g, "").toLowerCase().includes("projectcode")),
    name: logHeaders.findIndex(h => String(h).replace(/\s/g, "").includes("商談名")),
    start: logHeaders.findIndex(h => String(h).replace(/\s/g, "").includes("売上開始月")),
    end: logHeaders.findIndex(h => String(h).replace(/\s/g, "").includes("売上終了月")),
    product: logHeaders.findIndex(h => String(h).replace(/\s/g, "").includes("商品")),
    supplier: logHeaders.findIndex(h => String(h).replace(/\s/g, "").includes("仕入先")),
    url: logHeaders.indexOf("格納先フォルダURL") 
  };
  
  for (let i = 1; i < logData.length; i++) {
    const p = idx.pCode !== -1 ? formatCompareValue(logData[i][idx.pCode]) : "";
    const n = idx.name !== -1 ? formatCompareValue(logData[i][idx.name]) : "";
    const s = idx.start !== -1 ? formatCompareValue(logData[i][idx.start]) : "";
    const e = idx.end !== -1 ? formatCompareValue(logData[i][idx.end]) : "";
    const pr = idx.product !== -1 ? formatCompareValue(logData[i][idx.product]) : "";
    const su = idx.supplier !== -1 ? formatCompareValue(logData[i][idx.supplier]) : "";
    logSet.add(`${p}🏎️${n}🏎️${s}🏎️${e}🏎️${pr}🏎️${su}`);

    if (idx.oppId !== -1 && idx.url !== -1) {
      const oppIdStr = String(logData[i][idx.oppId]).trim();
      const urlStr = String(logData[i][idx.url]).trim();
      if (oppIdStr && urlStr) {
        logUrlMap[oppIdStr] = urlStr;
      }
    }
  }
  return { logSet, logUrlMap };
}

// ★修正：SalesforceのHTMLタグからURLを正確に抽出するロジックに強化
function parseSfDataAndDetectChanges(env, logSet, logUrlMap) {
  const { sfData, indices } = env;
  const groups = {};
  let hasAnyGroupChanged = false;

  for (let i = 1; i < sfData.length; i++) {
    const oppId = String(sfData[i][indices.oppId]).trim();
    const oppName = sfData[i][indices.name];
    
    // SF連携のファイルストレージ(URL)を取得
    let rawSfStorageUrl = (indices.sfStorageUrl !== -1 && sfData[i][indices.sfStorageUrl]) ? String(sfData[i][indices.sfStorageUrl]).trim() : "";
    
    // SalesforceのHTMLタグ（<a href="...">）から、正規のDrive URLを抽出する
    if (rawSfStorageUrl) {
      // 1. まず "https://drive.google.com/drive/folders/ID" の形がそのまま入っているか探す
      const urlMatch = rawSfStorageUrl.match(/https:\/\/drive\.google\.com\/drive\/folders\/[-\w]{25,}/);
      if (urlMatch) {
        rawSfStorageUrl = urlMatch[0]; // 綺麗なURLだけを切り抜く
      } else {
        // 2. 万が一見つからなかった場合の保険として、ID（25文字以上の英数字と記号）だけを抽出してURLを組み立てる
        const idMatch = rawSfStorageUrl.match(/[-\w]{25,}/); 
        if (idMatch) {
          rawSfStorageUrl = "https://drive.google.com/drive/folders/" + idMatch[0];
        } else {
          rawSfStorageUrl = ""; // 有効なIDがなければ空にする
        }
      }
    }

    const rawGasUrl = sfData[i][indices.url] ? String(sfData[i][indices.url]).trim() : "";
    const existingStatus = sfData[i][indices.status] ? String(sfData[i][indices.status]).trim() : "";
    
    if (!oppName) {
      if (rawSfStorageUrl || rawGasUrl || existingStatus) hasAnyGroupChanged = true; 
      continue;
    }

    // 優先順位: 1. SF連携のファイルストレージ(URL) -> 2. GAS生成URL -> 3. LogのURL
    let determinedUrl = "";
    if (rawSfStorageUrl) determinedUrl = rawSfStorageUrl;
    else if (rawGasUrl) determinedUrl = rawGasUrl;
    else if (logUrlMap[oppId]) determinedUrl = logUrlMap[oppId];
    
    let pCode = sfData[i][indices.pCode] ? String(sfData[i][indices.pCode]).trim() : "SFXXXXXXXX";
    const buVal = String(sfData[i][indices.bu]).trim() || "BU未指定";
    const deptVal = String(sfData[i][indices.dept]).trim() || "部署未指定";

    const startVal = indices.start !== -1 ? formatCompareValue(sfData[i][indices.start]) : "";
    const endVal = indices.end !== -1 ? formatCompareValue(sfData[i][indices.end]) : "";
    const prodVal = indices.product !== -1 ? formatCompareValue(sfData[i][indices.product]) : "";
    const suppVal = indices.supplier !== -1 ? formatCompareValue(sfData[i][indices.supplier]) : "";

    let isKamiki = true; 
    if (indices.start !== -1 && sfData[i][indices.start]) {
      const startDate = parseSafeDate(sfData[i][indices.start]);
      if (startDate) {
        const month = startDate.getMonth() + 1; 
        if (month >= 4 && month <= 9) isKamiki = true;
        else isKamiki = false;
      }
    }

    const groupKey = oppId ? "OPPID_" + oppId : "PJC_" + pCode + "_" + oppName.replace(/\s/g, "");

    if (!groups[groupKey]) {
      groups[groupKey] = {
        projectCode: pCode, oppName: oppName, buName: buVal, deptName: deptVal,
        supplierA: [], supplierB: [],
        rawStart: sfData[i][indices.start] || null, rawEnd: sfData[i][indices.end] || null,
        rowIndexes: [], folderUrl: determinedUrl, isChanged: false,
        isKamiki: isKamiki 
      };
    }

    groups[groupKey].rowIndexes.push(i + 1);

    if (indices.product !== -1 && indices.supplier !== -1 && suppVal) {
      if (/[BＢ]/.test(prodVal)) {
        if (!groups[groupKey].supplierB.includes(suppVal)) groups[groupKey].supplierB.push(suppVal);
      } else {
        if (!groups[groupKey].supplierA.includes(suppVal)) groups[groupKey].supplierA.push(suppVal);
      }
    }

    const currentLineKey = `${pCode}🏎️${oppName}🏎️${startVal}🏎️${endVal}🏎️${prodVal}🏎️${suppVal}`;
    if (!logSet.has(currentLineKey)) {
      groups[groupKey].isChanged = true;
      hasAnyGroupChanged = true;
    }
  }
  return { groups, hasAnyGroupChanged };
}

function buildFolderHierarchyData(env, groups) {
  let allGeneratedData = [];
  let groupsToProcess = []; 
  let no = 1;

  for (const key in groups) {
    const group = groups[key];
    if (!group.isChanged) continue;

    let monthList = [];
    if (group.rawStart && group.rawEnd) {
      let sDate = parseSafeDate(group.rawStart);
      let eDate = parseSafeDate(group.rawEnd);
      if (sDate && eDate) {
        let currentMonth = new Date(sDate.getTime()); currentMonth.setDate(1);
        let endMonth = new Date(eDate.getTime()); endMonth.setDate(1);
        while (currentMonth <= endMonth) {
          monthList.push(Utilities.formatDate(currentMonth, Session.getScriptTimeZone(), "yyyyMM"));
          currentMonth.setMonth(currentMonth.getMonth() + 1);
        }
      }
    }

    const layer1 = `PJC：${group.projectCode}（商談名：${group.oppName}）`;
    
    // 既存URLからの直接リネーム処理
    if (group.folderUrl) {
      const urlMatch = group.folderUrl.match(/[-\w]{25,}/);
      if (urlMatch) {
        try {
          let existingFolder = DriveApp.getFolderById(urlMatch[0]);
          if (existingFolder.getName() !== layer1) existingFolder.setName(layer1);
        } catch (e) {
          console.warn("URLからフォルダの特定に失敗: " + e.toString());
          group.folderUrl = ""; 
        }
      }
    }

    const result = buildLayerDataFromMaster(env.masterData, no, layer1, monthList, group.supplierA, group.supplierB, true);
    const dynamicInjectedData = result.data.map(row => {
      let newRow = [...row];
      newRow.splice(1, 0, group.buName, group.deptName); 
      newRow._groupRef = group;
      return newRow;
    });

    allGeneratedData.push(...dynamicInjectedData);
    no = result.nextNo;
    groupsToProcess.push(group);
  }
  return { allGeneratedData, groupsToProcess };
}

function writeWorkspaceData(mainSheet, allGeneratedData) {
  const maxCol = Math.max(...allGeneratedData.map(row => row.filter(cell => typeof cell !== 'object').length));
  const formattedData = allGeneratedData.map(row => {
    let newRow = row.filter(cell => typeof cell !== 'object');
    while (newRow.length < maxCol) newRow.push(""); 
    return newRow;
  });
  mainSheet.getRange(CONFIG.START_ROW, 1, formattedData.length, maxCol).setValues(formattedData);
  SpreadsheetApp.flush(); 
}

function executeFolderCreation(env, allGeneratedData, groupsToProcess, startTime) {
  let createdCount = 0;
  const folderCache = {}; 
  let layer1Urls = [];
  let newlyCreatedLayer1Folders = [];
  let seenLayer1InThisRun = new Set();
  const layer1UrlMapByName = {};
  
  const completedGroups = new Set();
  let isTimeout = false;

  for (let i = 0; i < allGeneratedData.length; i++) {
    const currentGroup = allGeneratedData[i]._groupRef;
    
    if (Date.now() - startTime > CONFIG.TIME_LIMIT_MS) {
      console.warn("実行時間制限到達のため中断します。動的トリガーで再開します。");
      isTimeout = true;
      break; 
    }

    const row = allGeneratedData[i].slice(1).filter(cell => typeof cell !== 'object');
    
    let folder = currentGroup.isKamiki ? env.folder_root_kamiki : env.folder_root_shimoki;
    let currentPath = currentGroup.isKamiki ? env.folder_id_root_kamiki : env.folder_id_root_shimoki;
    let currentLayer1Url = ""; 
    let isNewLayer1 = false;

    for (let j = 0; j < row.length; j++) {
      if (row[j] === "") continue;
      let folder_name = String(row[j]).trim();
      if (!folder_name) continue;

      currentPath += "/" + folder_name;

      if (j === 2 && currentGroup.folderUrl) {
        const match = currentGroup.folderUrl.match(/[-\w]{25,}/);
        if (match) {
          try {
            folder = DriveApp.getFolderById(match[0]); 
            folderCache[currentPath] = folder;
            currentLayer1Url = folder.getUrl();
            layer1UrlMapByName[folder_name] = currentLayer1Url;
            continue; 
          } catch (e) {}
        }
      }

      if (folderCache[currentPath]) {
        folder = folderCache[currentPath];
      } else {
        let folders = folder.getFoldersByName(folder_name);
        if (folders.hasNext()) {
          folder = folders.next();
        } else {
          folder = folder.createFolder(folder_name);
          createdCount++;
          if (j === 2) isNewLayer1 = true; 
        }
        folderCache[currentPath] = folder;
      }
      
      if (j === 2) {
        currentLayer1Url = folder.getUrl();
        layer1UrlMapByName[folder_name] = currentLayer1Url; 
        if (isNewLayer1 && !seenLayer1InThisRun.has(folder_name)) {
          newlyCreatedLayer1Folders.push({ name: folder_name, url: currentLayer1Url });
          seenLayer1InThisRun.add(folder_name);
        }
      }
    }
    
    completedGroups.add(currentGroup);
  }

  return { 
    createdCount, 
    layer1UrlMapByName, 
    newlyCreatedLayer1Folders, 
    isTimeout,
    completedGroups: Array.from(completedGroups)
  };
}

function syncUrlsAndStatuses(env, groups, layer1UrlMapByName = {}) {
  const urlRange = env.sfSheet.getRange(1, env.indices.url + 1, env.sfData.length, 1);
  const urlValues = urlRange.getValues();
  const statusRange = env.sfSheet.getRange(1, env.indices.status + 1, env.sfData.length, 1);
  const statusValues = statusRange.getValues();

  for (let r = 1; r < env.sfData.length; r++) {
    urlValues[r][0] = "";
    statusValues[r][0] = "";
  }

  for (const key in groups) {
    const group = groups[key];
    const latestLayer1Name = `PJC：${group.projectCode}（商談名：${group.oppName}）`;
    
    const latestUrl = layer1UrlMapByName[latestLayer1Name] || group.folderUrl;
    
    if (latestUrl) {
      group.rowIndexes.forEach(rowIdx => {
        urlValues[rowIdx - 1][0] = latestUrl;
        statusValues[rowIdx - 1][0] = "完了";
      });
    }
  }

  urlRange.setValues(urlValues);
  statusRange.setValues(statusValues);
  SpreadsheetApp.flush();
}

function finalizeWithoutChanges(env, ui) {
  env.logSheet.clear();
  const finalSfDataNoChange = env.sfSheet.getDataRange().getValues();
  env.logSheet.getRange(1, 1, finalSfDataNoChange.length, finalSfDataNoChange[0].length).setValues(finalSfDataNoChange);
  
  if (ui) ui.alert("処理完了（不要データのクリア、または変更箇所なしのためスキップ）");
  else console.log("変更なし・クリーンアップスキップ");
}

function finalizeWithNoMasterMatch(env, ui) {
  env.logSheet.clear();
  const finalData = env.sfSheet.getDataRange().getValues();
  env.logSheet.getRange(1, 1, finalData.length, finalData[0].length).setValues(finalData);
  
  if (ui) ui.alert("データ変更はありましたが、マスタ合致がないためスキップしました。");
  else console.log("マスタ合致なしスキップ");
}

function handleTimeoutEnd(env, completedGroups, createdCount, ui) {
  if (completedGroups.length > 0) {
    const freshSfData = env.sfSheet.getDataRange().getValues();
    const appendData = [];
    completedGroups.forEach(group => {
      group.rowIndexes.forEach(rowIdx => {
        appendData.push(freshSfData[rowIdx - 1]);
      });
    });
    
    const startRow = env.logSheet.getLastRow() + 1;
    if (startRow === 1) {
      appendData.unshift(env.headers);
    }
    env.logSheet.getRange(startRow, 1, appendData.length, appendData[0].length).setValues(appendData);
    SpreadsheetApp.flush();
  }

  setNextTrigger();

  const msg = `⚠️ 処理時間が上限に達したため中断しました。\n今回新たに ${createdCount} 個のフォルダを作成しました。\n残りの未処理分は自動的に1分後に再開されます。`;
  if (ui) ui.alert(msg);
  else console.log(msg);
}

function finalizeSuccess(env, createdCount, ui) {
  env.logSheet.clear();
  const finalData = env.sfSheet.getDataRange().getValues(); 
  env.logSheet.getRange(1, 1, finalData.length, finalData[0].length).setValues(finalData);

  const msg = `処理完了：新たに ${createdCount} 個のフォルダを差分作成しました。\nすべての案件の処理が完了しました。`;
  if (ui) ui.alert(msg);
  else console.log(msg);
}
